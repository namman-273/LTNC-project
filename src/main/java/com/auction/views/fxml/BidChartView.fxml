<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.chart.LineChart?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.geometry.Insets?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.auction.controller.ui.BidChartController"
      prefWidth="700" prefHeight="500" spacing="0"
      stylesheets="@../style/style.css"
      style="-fx-background-color: #0F172A;">

    <!-- HEADER -->
    <HBox alignment="CENTER_LEFT" spacing="12"
          style="-fx-background-color: #0B1120;
                 -fx-padding: 0 24; -fx-pref-height: 56;
                 -fx-border-color: transparent transparent #1E3A5F transparent;
                 -fx-border-width: 1;">
        <Button text="← Quay lại" onAction="#handleBack"
                styleClass="btn-ghost"
                style="-fx-font-size: 12px; -fx-padding: 6 14;"/>
        <Label fx:id="titleLabel" text="Biểu đồ giá đấu giá"
               style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #E2E8F0;"/>
    </HBox>

    <!-- CHART -->
    <VBox VBox.vgrow="ALWAYS" style="-fx-padding: 20; -fx-background-color: #0F172A;">
        <LineChart fx:id="bidChart" VBox.vgrow="ALWAYS"
                   animated="true"
                   style="-fx-background-color: #0B1120;
                          -fx-background-radius: 12;
                          -fx-border-color: #1E3A5F;
                          -fx-border-radius: 12;
                          -fx-border-width: 1;
                          -fx-padding: 10;">
            <xAxis>
                <NumberAxis fx:id="xAxis" label="Lần đặt giá" autoRanging="true"
                            style="-fx-tick-label-fill: #64748B; -fx-minor-tick-visible: false;"/>
            </xAxis>
            <yAxis>
                <NumberAxis fx:id="yAxis" label="Giá (VND)" autoRanging="true"
                            style="-fx-tick-label-fill: #64748B; -fx-minor-tick-visible: false;"/>
            </yAxis>
        </LineChart>
    </VBox>

</VBox>
