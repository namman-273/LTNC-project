<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.geometry.Insets?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.auction.controller.ui.AutoBidController"
      prefWidth="480" prefHeight="420" spacing="0"
      stylesheets="@../style/style.css"
      style="-fx-background-color: #F8F9FA;">

    <!-- HEADER -->
    <HBox alignment="CENTER_LEFT" spacing="14"
          style="-fx-background-color: linear-gradient(to right, #1565C0, #2196F3);
                 -fx-padding: 0 24; -fx-pref-height: 60;
                 -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.2), 8, 0, 0, 3);">
        <Button text="← Quay lại" onAction="#handleBack"
                style="-fx-background-color: rgba(255,255,255,0.15);
                       -fx-text-fill: white; -fx-font-size: 12px;
                       -fx-background-radius: 8; -fx-cursor: hand;
                       -fx-border-color: rgba(255,255,255,0.4);
                       -fx-border-radius: 8; -fx-border-width: 1;
                       -fx-padding: 6 14;"/>
        <Label fx:id="titleLabel" text="🤖 Auto-Bid"
               style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: white;"/>
    </HBox>

    <!-- CONTENT -->
    <VBox spacing="20" VBox.vgrow="ALWAYS">
        <padding><Insets top="24" right="40" bottom="20" left="40"/></padding>

        <!-- Current AutoBid Info -->
        <VBox spacing="8"
              style="-fx-background-color: #E3F2FD;
                     -fx-background-radius: 10;
                     -fx-padding: 16;
                     -fx-border-color: #90CAF9;
                     -fx-border-radius: 10;
                     -fx-border-width: 1;">
            <Label text="📋 Auto-Bid hiện tại"
                   style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #1565C0;"/>
            <Label fx:id="currentAutoBidLabel" text="Chưa đặt auto-bid cho phiên này"
                   style="-fx-font-size: 12px; -fx-text-fill: #555;" wrapText="true"/>
        </VBox>

        <!-- Set AutoBid Card -->
        <VBox spacing="14"
              style="-fx-background-color: white;
                     -fx-background-radius: 12;
                     -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 8, 0, 0, 2);
                     -fx-padding: 20;">
            <Label text="🤖 Cài đặt Auto-Bid"
                   style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #1565C0;"/>

            <VBox spacing="6">
                <Label text="Giá tối đa sẵn sàng trả (VNĐ):"
                       style="-fx-font-size: 12px; -fx-text-fill: #666;"/>
                <TextField fx:id="maxBidField"
                           promptText="Nhập giá tối đa..."
                           prefHeight="40"
                           styleClass="text-field-modern"/>
            </VBox>

            <VBox spacing="6">
                <Label text="Bước tăng mỗi lần (VNĐ):"
                       style="-fx-font-size: 12px; -fx-text-fill: #666;"/>
                <TextField fx:id="incrementField"
                           promptText="Nhập bước tăng..."
                           prefHeight="40"
                           styleClass="text-field-modern"/>
            </VBox>

            <Label text="💡 Hệ thống sẽ tự động đặt giá thay bạn khi có người đặt cao hơn,
cho đến khi đạt giá tối đa."
                   style="-fx-font-size: 11px; -fx-text-fill: #888;"
                   wrapText="true"/>

            <Button text="🤖 BẬT AUTO-BID" onAction="#handleSetAutoBid"
                    prefWidth="400" prefHeight="42"
                    styleClass="btn-primary"
                    style="-fx-font-size: 13px; -fx-font-weight: bold;"/>

            <Label fx:id="messageLabel" text=""
                   style="-fx-font-size: 12px;" wrapText="true"/>
        </VBox>
    </VBox>
</VBox>
