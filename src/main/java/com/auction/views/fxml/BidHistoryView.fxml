<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>

<HBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.auction.controller.ui.BidHistoryController"
      prefWidth="1000" prefHeight="680" spacing="0"
      stylesheets="@../style/style.css"
      style="-fx-background-color: #0F172A;">

    <!-- SIDEBAR -->
    <VBox prefWidth="220" spacing="0"
          style="-fx-background-color: #0B1120;
                 -fx-border-color: transparent #1E3A5F transparent transparent;
                 -fx-border-width: 1;">
        <HBox alignment="CENTER_LEFT" spacing="10"
              style="-fx-padding: 18 16;
                     -fx-border-color: transparent transparent #1E3A5F transparent;
                     -fx-border-width: 1;">
            <Label text="&#x1F3DB;"
                   style="-fx-font-size: 20px;
                          -fx-font-family: 'Segoe UI Emoji','Apple Color Emoji',sans-serif;
                          -fx-effect: dropshadow(gaussian,rgba(96,165,250,0.7),8,0,0,0);"/>
            <VBox spacing="1">
                <Label text="1388AUCTION"
                       style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #93C5FD;
                              -fx-effect: dropshadow(gaussian,rgba(59,130,246,0.5),4,0,0,0);"/>
                <Label text="Hệ thống đấu giá"
                       style="-fx-font-size: 9px; -fx-text-fill: #475569;"/>
            </VBox>
        </HBox>
        <VBox alignment="CENTER" spacing="6"
              style="-fx-padding: 14 16 12 16;
                     -fx-border-color: transparent transparent #1E3A5F transparent;
                     -fx-border-width: 1; -fx-background-color: rgba(30,45,69,0.5);">
            <Label text="&#x1F464;"
                   style="-fx-font-size: 28px; -fx-background-color: #1E3A5F;
                          -fx-background-radius: 26; -fx-padding: 7 11;"/>
        </VBox>
        <VBox spacing="2" style="-fx-padding: 12 10;" VBox.vgrow="ALWAYS">
            <Button text="&#x1F3E0;  Trang chủ" onAction="#handleHome"
                    prefWidth="200" prefHeight="40"
                    style="-fx-background-color: transparent; -fx-text-fill: #64748B;
                           -fx-font-size: 13px; -fx-background-radius: 10; -fx-cursor: hand;
                           -fx-alignment: CENTER_LEFT; -fx-padding: 0 14;"/>
            <Button text="&#x1F4DC;  Lịch sử đấu giá"
                    prefWidth="200" prefHeight="40"
                    style="-fx-background-color: rgba(59,130,246,0.16); -fx-text-fill: #60A5FA;
                           -fx-font-size: 13px; -fx-font-weight: bold;
                           -fx-background-radius: 10; -fx-cursor: hand;
                           -fx-alignment: CENTER_LEFT; -fx-padding: 0 14;
                           -fx-border-color: transparent transparent transparent #3B82F6;
                           -fx-border-width: 0 0 0 3;"/>
            <Button text="&#x2B50;  Watchlist" onAction="#handleWatchlist"
                    prefWidth="200" prefHeight="40"
                    style="-fx-background-color: transparent; -fx-text-fill: #64748B;
                           -fx-font-size: 13px; -fx-background-radius: 10; -fx-cursor: hand;
                           -fx-alignment: CENTER_LEFT; -fx-padding: 0 14;"/>
            <Button text="&#x1F464;  Hồ sơ cá nhân" onAction="#handleProfile"
                    prefWidth="200" prefHeight="40"
                    style="-fx-background-color: transparent; -fx-text-fill: #64748B;
                           -fx-font-size: 13px; -fx-background-radius: 10; -fx-cursor: hand;
                           -fx-alignment: CENTER_LEFT; -fx-padding: 0 14;"/>
            <Region VBox.vgrow="ALWAYS"/>
            <Label style="-fx-border-color: #1E3A5F; -fx-border-width: 1 0 0 0;
                          -fx-min-height: 1; -fx-max-height: 1;" prefWidth="200"/>
            <Button text="&#x1F6AA;  Đăng xuất" onAction="#handleBack"
                    prefWidth="200" prefHeight="38"
                    style="-fx-background-color: transparent; -fx-text-fill: #F87171;
                           -fx-font-size: 13px; -fx-background-radius: 10; -fx-cursor: hand;
                           -fx-alignment: CENTER_LEFT; -fx-padding: 0 14;"/>
        </VBox>
    </VBox>

    <!-- MAIN CONTENT -->
    <VBox HBox.hgrow="ALWAYS" spacing="0" style="-fx-background-color: #0F172A;">

        <!-- HEADER — không có icon ví/chuông -->
        <HBox alignment="CENTER_LEFT" spacing="12"
              style="-fx-background-color: #0B1120;
                     -fx-padding: 0 20; -fx-pref-height: 60;
                     -fx-border-color: transparent transparent #1E3A5F transparent;
                     -fx-border-width: 1;">
            <Button text="←" onAction="#handleBack"
                    styleClass="btn-ghost" style="-fx-font-size: 16px; -fx-padding: 4 12;"/>
            <StackPane style="-fx-background-color: rgba(59,130,246,0.18);
                              -fx-background-radius: 20;
                              -fx-min-width: 38; -fx-min-height: 38;
                              -fx-max-width: 38; -fx-max-height: 38;">
                <Label text="&#x1F4DC;"
                       style="-fx-font-size: 16px;
                              -fx-font-family: 'Segoe UI Emoji','Apple Color Emoji',sans-serif;"/>
            </StackPane>
            <VBox spacing="1">
                <Label text="Lịch sử phiên đấu giá"
                       style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #E2E8F0;"/>
                <Label fx:id="subtitleLabel" text="0 phiên đã tham gia"
                       style="-fx-font-size: 11px; -fx-text-fill: #475569;"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <!-- Icon ví -->
            <HBox onMouseClicked="#handleGoBalance" alignment="CENTER"
                  prefHeight="36" prefWidth="36"
                  style="-fx-background-color: rgba(96,165,250,0.12); -fx-background-radius: 18;
                         -fx-cursor: hand; -fx-border-color: rgba(59,130,246,0.3); -fx-border-radius: 18;
                         -fx-border-width: 1;
                         -fx-effect: dropshadow(gaussian,rgba(96,165,250,0.2),6,0,0,0);">
                <Label text="&#x1F4B0;"
                       style="-fx-font-size: 16px; -fx-text-fill: white;
                              -fx-font-family: 'Segoe UI Emoji','Apple Color Emoji',sans-serif;"/>
            </HBox>
            <!-- Icon chuông -->
            <HBox onMouseClicked="#handleGoNotification" alignment="CENTER"
                  prefHeight="36" prefWidth="36"
                  style="-fx-background-color: rgba(251,191,36,0.12); -fx-background-radius: 18;
                         -fx-cursor: hand; -fx-border-color: rgba(251,191,36,0.3); -fx-border-radius: 18;
                         -fx-border-width: 1;
                         -fx-effect: dropshadow(gaussian,rgba(251,191,36,0.2),6,0,0,0);">
                <Label text="&#x1F514;"
                       style="-fx-font-size: 16px; -fx-text-fill: white;
                              -fx-font-family: 'Segoe UI Emoji','Apple Color Emoji',sans-serif;"/>
            </HBox>
        </HBox>

        <!-- STATS ROW -->
        <HBox spacing="0"
              style="-fx-background-color: #0B1120;
                     -fx-border-color: transparent transparent #1E3A5F transparent;
                     -fx-border-width: 1;">
            <VBox alignment="CENTER" spacing="3" HBox.hgrow="ALWAYS"
                  style="-fx-padding: 14 0;
                         -fx-border-color: transparent #1E3A5F transparent transparent;
                         -fx-border-width: 1;">
                <Label fx:id="totalLabel" text="0"
                       style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #60A5FA;"/>
                <Label text="Tổng phiên" style="-fx-font-size: 10px; -fx-text-fill: #475569;"/>
            </VBox>
            <VBox alignment="CENTER" spacing="3" HBox.hgrow="ALWAYS"
                  style="-fx-padding: 14 0;
                         -fx-border-color: transparent #1E3A5F transparent transparent;
                         -fx-border-width: 1;">
                <Label fx:id="winLabel" text="0"
                       style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #34D399;"/>
                <Label text="Thắng" style="-fx-font-size: 10px; -fx-text-fill: #475569;"/>
            </VBox>
            <VBox alignment="CENTER" spacing="3" HBox.hgrow="ALWAYS"
                  style="-fx-padding: 14 0;
                         -fx-border-color: transparent #1E3A5F transparent transparent;
                         -fx-border-width: 1;">
                <Label fx:id="loseLabel" text="0"
                       style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #F87171;"/>
                <Label text="Thua" style="-fx-font-size: 10px; -fx-text-fill: #475569;"/>
            </VBox>
            <VBox alignment="CENTER" spacing="3" HBox.hgrow="ALWAYS"
                  style="-fx-padding: 14 0;">
                <Label fx:id="rateLabel" text="0%"
                       style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #FBBF24;"/>
                <Label text="Tỉ lệ thắng" style="-fx-font-size: 10px; -fx-text-fill: #475569;"/>
            </VBox>
        </HBox>

        <!-- TAB FILTER -->
        <HBox spacing="6" alignment="CENTER_LEFT"
              style="-fx-background-color: #0B1120; -fx-padding: 10 20;
                     -fx-border-color: transparent transparent #1E3A5F transparent;
                     -fx-border-width: 1;">
            <Button fx:id="tabAll" text="Tất cả" onAction="#handleTabAll"
                    style="-fx-background-color: linear-gradient(to right,#2563EB,#3B82F6);
                           -fx-text-fill: white; -fx-font-weight: bold;
                           -fx-background-radius: 20; -fx-padding: 6 18;
                           -fx-cursor: hand; -fx-font-size: 12px; -fx-border-color: transparent;"/>
            <Button fx:id="tabWin" text="✓ Thắng" onAction="#handleTabWin"
                    style="-fx-background-color: transparent; -fx-text-fill: #475569;
                           -fx-background-radius: 20; -fx-padding: 6 18;
                           -fx-cursor: hand; -fx-font-size: 12px;
                           -fx-border-color: #1E3A5F; -fx-border-radius: 20; -fx-border-width: 1;"/>
            <Button fx:id="tabLose" text="✗ Thua" onAction="#handleTabLose"
                    style="-fx-background-color: transparent; -fx-text-fill: #475569;
                           -fx-background-radius: 20; -fx-padding: 6 18;
                           -fx-cursor: hand; -fx-font-size: 12px;
                           -fx-border-color: #1E3A5F; -fx-border-radius: 20; -fx-border-width: 1;"/>
        </HBox>

        <!-- LIST -->
        <ListView fx:id="historyList" VBox.vgrow="ALWAYS"
                  style="-fx-background-color: #0F172A; -fx-border-color: transparent;
                         -fx-background-insets: 0; -fx-padding: 10 16 10 16;">
            <placeholder>
                <VBox alignment="CENTER" spacing="12" style="-fx-padding: 80 0;">
                    <Label text="&#x1F4DC;"
                           style="-fx-font-size: 48px; -fx-opacity: 0.2;
                                  -fx-font-family: 'Segoe UI Emoji','Apple Color Emoji',sans-serif;"/>
                    <Label text="Chưa có lịch sử đấu giá"
                           style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #334155;"/>
                    <Label text="Các phiên bạn đã tham gia sẽ hiện ở đây"
                           style="-fx-font-size: 12px; -fx-text-fill: #334155;"/>
                </VBox>
            </placeholder>
        </ListView>

    </VBox>
</HBox>
