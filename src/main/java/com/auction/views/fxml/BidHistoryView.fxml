<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.geometry.Insets?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.auction.controller.ui.BidHistoryController"
      prefWidth="600" prefHeight="660" spacing="0"
      stylesheets="@../style/style.css"
      style="-fx-background-color: #F5F6FA;">

    <!-- HEADER -->
    <HBox alignment="CENTER_LEFT" spacing="12"
          style="-fx-background-color: #1565C0;
                 -fx-padding: 0 20; -fx-pref-height: 60;">
        <Button text="←" onAction="#handleBack"
                style="-fx-background-color: rgba(255,255,255,0.15);
                       -fx-text-fill: white; -fx-font-size: 16px;
                       -fx-background-radius: 8; -fx-cursor: hand;
                       -fx-border-color: rgba(255,255,255,0.3);
                       -fx-border-radius: 8; -fx-border-width: 1;
                       -fx-padding: 4 12;"/>
        <StackPane style="-fx-background-color: rgba(255,255,255,0.2);
                          -fx-background-radius: 20;
                          -fx-min-width: 38; -fx-min-height: 38;
                          -fx-max-width: 38; -fx-max-height: 38;">
            <Label text="📋" style="-fx-font-size: 17px;"/>
        </StackPane>
        <VBox spacing="1">
            <Label text="Lịch sử phiên đấu giá"
                   style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: white;"/>
            <Label fx:id="subtitleLabel" text="0 phiên đã tham gia"
                   style="-fx-font-size: 11px; -fx-text-fill: rgba(255,255,255,0.7);"/>
        </VBox>
    </HBox>

    <!-- STATS ROW -->
    <HBox spacing="0"
          style="-fx-background-color: white;
                 -fx-border-color: transparent transparent #EBEBEB transparent;
                 -fx-border-width: 1;">
        <VBox alignment="CENTER" spacing="3" HBox.hgrow="ALWAYS"
              style="-fx-padding: 14 0;
                     -fx-border-color: transparent #F0F0F0 transparent transparent;
                     -fx-border-width: 1;">
            <Label fx:id="totalLabel" text="0"
                   style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #1565C0;"/>
            <Label text="Tổng phiên"
                   style="-fx-font-size: 10px; -fx-text-fill: #9CA3AF;"/>
        </VBox>
        <VBox alignment="CENTER" spacing="3" HBox.hgrow="ALWAYS"
              style="-fx-padding: 14 0;
                     -fx-border-color: transparent #F0F0F0 transparent transparent;
                     -fx-border-width: 1;">
            <Label fx:id="winLabel" text="0"
                   style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #22C55E;"/>
            <Label text="Thắng"
                   style="-fx-font-size: 10px; -fx-text-fill: #9CA3AF;"/>
        </VBox>
        <VBox alignment="CENTER" spacing="3" HBox.hgrow="ALWAYS"
              style="-fx-padding: 14 0;
                     -fx-border-color: transparent #F0F0F0 transparent transparent;
                     -fx-border-width: 1;">
            <Label fx:id="loseLabel" text="0"
                   style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #EF4444;"/>
            <Label text="Thua"
                   style="-fx-font-size: 10px; -fx-text-fill: #9CA3AF;"/>
        </VBox>
        <VBox alignment="CENTER" spacing="3" HBox.hgrow="ALWAYS"
              style="-fx-padding: 14 0;">
            <Label fx:id="rateLabel" text="0%"
                   style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #F59E0B;"/>
            <Label text="Tỉ lệ thắng"
                   style="-fx-font-size: 10px; -fx-text-fill: #9CA3AF;"/>
        </VBox>
    </HBox>

    <!-- TAB FILTER -->
    <HBox spacing="6" alignment="CENTER_LEFT"
          style="-fx-background-color: white;
                 -fx-padding: 10 16;
                 -fx-border-color: transparent transparent #EBEBEB transparent;
                 -fx-border-width: 1;">
        <Button fx:id="tabAll" text="Tất cả" onAction="#handleTabAll"
                style="-fx-background-color: #111827; -fx-text-fill: white;
                       -fx-font-weight: bold; -fx-background-radius: 20;
                       -fx-padding: 6 18; -fx-cursor: hand; -fx-font-size: 12px;
                       -fx-border-color: transparent;"/>
        <Button fx:id="tabWin" text="✓ Thắng" onAction="#handleTabWin"
                style="-fx-background-color: transparent; -fx-text-fill: #6B7280;
                       -fx-background-radius: 20; -fx-padding: 6 18;
                       -fx-cursor: hand; -fx-font-size: 12px;
                       -fx-border-color: #E5E7EB; -fx-border-radius: 20; -fx-border-width: 1;"/>
        <Button fx:id="tabLose" text="✗ Thua" onAction="#handleTabLose"
                style="-fx-background-color: transparent; -fx-text-fill: #6B7280;
                       -fx-background-radius: 20; -fx-padding: 6 18;
                       -fx-cursor: hand; -fx-font-size: 12px;
                       -fx-border-color: #E5E7EB; -fx-border-radius: 20; -fx-border-width: 1;"/>
    </HBox>

    <!-- LIST -->
    <ListView fx:id="historyList" VBox.vgrow="ALWAYS"
              style="-fx-background-color: #F5F6FA;
                     -fx-border-color: transparent;
                     -fx-background-insets: 0;
                     -fx-padding: 10 12 10 12;">
        <placeholder>
            <VBox alignment="CENTER" spacing="12" style="-fx-padding: 80 0;">
                <Label text="📋" style="-fx-font-size: 48px; -fx-opacity: 0.25;"/>
                <Label text="Chưa có lịch sử đấu giá"
                       style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #374151;"/>
                <Label text="Các phiên bạn đã tham gia sẽ hiện ở đây"
                       style="-fx-font-size: 12px; -fx-text-fill: #9CA3AF;"/>
            </VBox>
        </placeholder>
    </ListView>

</VBox>