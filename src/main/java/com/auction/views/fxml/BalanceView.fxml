<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.geometry.Insets?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.auction.controllers.BalanceController"
      prefWidth="520" prefHeight="620" spacing="0"
      stylesheets="@style.css"
      style="-fx-background-color: #F0F4FF;">

    <!-- HEADER -->
    <HBox alignment="CENTER_LEFT" spacing="14"
          style="-fx-background-color: linear-gradient(to right, #1565C0, #2196F3);
                 -fx-padding: 0 24; -fx-pref-height: 60;
                 -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.2), 8, 0, 0, 3);">
        <Button text="← Quay lại" onAction="#handleBack"
                style="-fx-background-color: rgba(255,255,255,0.15);
                       -fx-text-fill: white; -fx-font-size: 12px;
                       -fx-background-radius: 8; -fx-cursor: hand;
                       -fx-border-color: rgba(255,255,255,0.4);
                       -fx-border-radius: 8; -fx-border-width: 1;
                       -fx-padding: 6 14;"/>
        <Label text="💰 VÍ TIỀN"
               style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: white;"/>
    </HBox>

    <VBox spacing="16" VBox.vgrow="ALWAYS">
        <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>

        <!-- Balance Card — style cam giống ảnh -->
        <VBox spacing="6"
              style="-fx-background-color: linear-gradient(to right, #1565C0, #2196F3);
                     -fx-background-radius: 14;
                     -fx-effect: dropshadow(gaussian, rgba(21,101,192,0.3), 12, 0, 0, 4);
                     -fx-padding: 24;">
            <Label fx:id="usernameLabel" text="Tài khoản: ---"
                   style="-fx-font-size: 12px; -fx-text-fill: rgba(255,255,255,0.8);"/>
            <Label text="Số dư khả dụng"
                   style="-fx-font-size: 13px; -fx-text-fill: rgba(255,255,255,0.9);"/>
            <Label fx:id="balanceLabel" text="Đang tải..."
                   style="-fx-font-size: 30px; -fx-font-weight: bold; -fx-text-fill: white;"/>
            <HBox spacing="10" style="-fx-padding: 10 0 0 0;">
                <Button text="💳 Nạp tiền" onAction="#handleDeposit"
                        style="-fx-background-color: white;
                               -fx-text-fill: #1565C0;
                               -fx-font-weight: bold;
                               -fx-background-radius: 8;
                               -fx-cursor: hand;
                               -fx-padding: 8 20;"/>
                <Button text="🔄 Làm mới" onAction="#handleRefresh"
                        style="-fx-background-color: rgba(255,255,255,0.2);
                               -fx-text-fill: white;
                               -fx-background-radius: 8;
                               -fx-cursor: hand;
                               -fx-padding: 8 20;"/>
            </HBox>
        </VBox>

        <!-- Deposit input -->
        <VBox spacing="8"
              style="-fx-background-color: white;
                     -fx-background-radius: 12;
                     -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 6, 0, 0, 2);
                     -fx-padding: 16;">
            <Label text="Số tiền muốn nạp (VNĐ):"
                   style="-fx-font-size: 12px; -fx-text-fill: #666;"/>
            <HBox spacing="10">
                <TextField fx:id="depositAmountField"
                           promptText="Nhập số tiền..."
                           prefHeight="38" HBox.hgrow="ALWAYS"
                           styleClass="text-field-modern"/>
                <Button text="Nạp" onAction="#handleDeposit"
                        prefHeight="38" prefWidth="70"
                        styleClass="btn-primary"/>
            </HBox>
            <Label fx:id="messageLabel" text=""
                   style="-fx-font-size: 12px;" wrapText="true"/>
        </VBox>

        <!-- Transaction History -->
        <VBox spacing="10" VBox.vgrow="ALWAYS"
              style="-fx-background-color: white;
                     -fx-background-radius: 12;
                     -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 6, 0, 0, 2);
                     -fx-padding: 16;">
            <HBox alignment="CENTER_LEFT">
                <Label text="📋 Lịch sử giao dịch"
                       style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #1565C0;"/>
                <Region HBox.hgrow="ALWAYS"/>
            </HBox>
            <ListView fx:id="transactionList" VBox.vgrow="ALWAYS"
                      prefHeight="200"
                      style="-fx-background-color: transparent;
                             -fx-border-color: #EEEEEE;
                             -fx-border-radius: 8;">
                <placeholder>
                    <Label text="Chưa có giao dịch nào."
                           style="-fx-text-fill: #AAAAAA; -fx-font-size: 12px;"/>
                </placeholder>
            </ListView>
        </VBox>
    </VBox>
</VBox>