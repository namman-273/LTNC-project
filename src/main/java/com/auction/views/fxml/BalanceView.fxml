<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.geometry.Insets?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.auction.controller.ui.BalanceController"
      prefWidth="540" prefHeight="660" spacing="0"
      stylesheets="@../style/style.css"
      style="-fx-background-color: #0F172A;">

    <!-- HEADER -->
    <HBox alignment="CENTER_LEFT" spacing="14"
          style="-fx-background-color: #0B1120;
                 -fx-padding: 0 24; -fx-pref-height: 60;
                 -fx-border-color: transparent transparent #1E3A5F transparent;
                 -fx-border-width: 1;
                 -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.4), 8, 0, 0, 3);">
        <Button text="← Quay lại" onAction="#handleBack"
                styleClass="btn-ghost"
                style="-fx-font-size: 12px; -fx-padding: 6 14;"/>
        <Label text="💰 VÍ TIỀN"
               style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #E2E8F0;"/>
    </HBox>

    <VBox spacing="16" VBox.vgrow="ALWAYS" style="-fx-background-color: #0F172A;">
        <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>

        <!-- Balance Card -->
        <VBox spacing="0"
              style="-fx-background-color: #0B1120; -fx-background-radius: 16;
                     -fx-border-color: #1E3A5F; -fx-border-radius: 16; -fx-border-width: 1;
                     -fx-effect: dropshadow(gaussian, rgba(59,130,246,0.15), 16, 0, 0, 4);">

            <!-- Top gradient band -->
            <HBox alignment="CENTER_LEFT" spacing="0"
                  style="-fx-background-color: linear-gradient(to right, #1E3A5F, #2563EB);
                         -fx-background-radius: 16 16 0 0; -fx-padding: 14 20;">
                <Label text="💳"
                       style="-fx-font-size: 20px;"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label text="1388AUCTION WALLET"
                       style="-fx-font-size: 10px; -fx-text-fill: rgba(255,255,255,0.6);
                              -fx-font-weight: bold;"/>
            </HBox>

            <!-- Balance body -->
            <VBox spacing="8" style="-fx-padding: 20 24 24 24;">
                <Label fx:id="usernameLabel" text="Tài khoản: ---"
                       style="-fx-font-size: 12px; -fx-text-fill: #64748B;"/>
                <Label text="Số dư khả dụng"
                       style="-fx-font-size: 12px; -fx-text-fill: #94A3B8;"/>
                <Label fx:id="balanceLabel" text="Đang tải..."
                       style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #60A5FA;"
                       wrapText="true" maxWidth="460"/>

                <Region prefHeight="4"/>

                <!-- Nạp tiền button -->
                <HBox spacing="10">
                    <Button text="💳 Nạp tiền" onAction="#handleDeposit"
                            prefHeight="38"
                            style="-fx-background-color: linear-gradient(to right,#2563EB,#3B82F6);
                                   -fx-text-fill: white; -fx-font-weight: bold;
                                   -fx-background-radius: 10; -fx-cursor: hand;
                                   -fx-padding: 0 24;
                                   -fx-effect: dropshadow(gaussian,rgba(59,130,246,0.4),8,0,0,2);"/>
                </HBox>
            </VBox>
        </VBox>

        <!-- Deposit Input -->
        <VBox spacing="10"
              style="-fx-background-color: #0B1120;
                     -fx-background-radius: 14;
                     -fx-border-color: #1E3A5F; -fx-border-radius: 14; -fx-border-width: 1;
                     -fx-padding: 18;">
            <Label text="Nhập số tiền muốn nạp (VNĐ)"
                   style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #94A3B8;"/>

            <!-- Quick amounts -->
            <HBox spacing="8">
                <Button text="100K" onAction="#handleDeposit"
                        HBox.hgrow="ALWAYS" prefHeight="34"
                        style="-fx-background-color: #162236; -fx-text-fill: #64748B;
                               -fx-font-size: 11px; -fx-font-weight: bold;
                               -fx-background-radius: 8; -fx-cursor: hand;
                               -fx-border-color: #1E3A5F; -fx-border-radius: 8; -fx-border-width: 1;"/>
                <Button text="500K" onAction="#handleDeposit"
                        HBox.hgrow="ALWAYS" prefHeight="34"
                        style="-fx-background-color: #162236; -fx-text-fill: #64748B;
                               -fx-font-size: 11px; -fx-font-weight: bold;
                               -fx-background-radius: 8; -fx-cursor: hand;
                               -fx-border-color: #1E3A5F; -fx-border-radius: 8; -fx-border-width: 1;"/>
                <Button text="1M" onAction="#handleDeposit"
                        HBox.hgrow="ALWAYS" prefHeight="34"
                        style="-fx-background-color: #162236; -fx-text-fill: #64748B;
                               -fx-font-size: 11px; -fx-font-weight: bold;
                               -fx-background-radius: 8; -fx-cursor: hand;
                               -fx-border-color: #1E3A5F; -fx-border-radius: 8; -fx-border-width: 1;"/>
                <Button text="5M" onAction="#handleDeposit"
                        HBox.hgrow="ALWAYS" prefHeight="34"
                        style="-fx-background-color: #162236; -fx-text-fill: #64748B;
                               -fx-font-size: 11px; -fx-font-weight: bold;
                               -fx-background-radius: 8; -fx-cursor: hand;
                               -fx-border-color: #1E3A5F; -fx-border-radius: 8; -fx-border-width: 1;"/>
            </HBox>

            <HBox spacing="10">
                <TextField fx:id="depositAmountField"
                           promptText="Nhập số tiền..."
                           prefHeight="42" HBox.hgrow="ALWAYS"
                           styleClass="text-field-modern"/>
                <Button text="Nạp" onAction="#handleDeposit"
                        prefHeight="42" prefWidth="80"
                        styleClass="btn-primary"/>
            </HBox>
            <Label fx:id="messageLabel" text=""
                   style="-fx-font-size: 12px;" wrapText="true"/>
        </VBox>

        <!-- Transaction History -->
        <VBox spacing="12" VBox.vgrow="ALWAYS"
              style="-fx-background-color: #0B1120;
                     -fx-background-radius: 14;
                     -fx-border-color: #1E3A5F; -fx-border-radius: 14; -fx-border-width: 1;
                     -fx-padding: 18;">
            <HBox alignment="CENTER_LEFT">
                <Label text="📋 Lịch sử giao dịch"
                       style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #E2E8F0;"/>
                <Region HBox.hgrow="ALWAYS"/>
            </HBox>
            <ListView fx:id="transactionList" VBox.vgrow="ALWAYS"
                      prefHeight="180"
                      style="-fx-background-color: transparent;
                             -fx-border-color: #1E3A5F;
                             -fx-border-radius: 8;">
                <placeholder>
                    <VBox alignment="CENTER" spacing="8" style="-fx-padding: 24 0;">
                        <Label text="💸"
                               style="-fx-font-size: 32px; -fx-opacity: 0.2;"/>
                        <Label text="Chưa có giao dịch nào."
                               style="-fx-text-fill: #334155; -fx-font-size: 12px;"/>
                    </VBox>
                </placeholder>
            </ListView>
        </VBox>

    </VBox>
</VBox>
