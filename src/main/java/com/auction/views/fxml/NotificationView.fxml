<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.geometry.Insets?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.auction.controller.ui.NotificationController"
      prefWidth="480" prefHeight="580" spacing="0"
      stylesheets="@../style/style.css"
      style="-fx-background-color: #F0F4FF;">

    <!-- HEADER -->
    <HBox alignment="CENTER_LEFT" spacing="14"
          style="-fx-background-color: linear-gradient(to right, #1565C0, #2196F3);
                 -fx-padding: 0 24; -fx-pref-height: 60;
                 -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.2), 8, 0, 0, 3);">

        <Button text="← Quay lại" onAction="#handleBack"
                style="-fx-background-color: rgba(255,255,255,0.15);
                       -fx-text-fill: white; -fx-font-size: 12px;
                       -fx-background-radius: 8; -fx-cursor: hand;
                       -fx-border-color: rgba(255,255,255,0.4);
                       -fx-border-radius: 8; -fx-border-width: 1;
                       -fx-padding: 6 14;"/>

        <Label text="🔔 THÔNG BÁO"
               style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: white;"/>

        <Region HBox.hgrow="ALWAYS"/>

        <!-- Count badge -->
        <StackPane>
            <Label fx:id="countLabel" text="0"
                   style="-fx-background-color: #EF4444;
                          -fx-text-fill: white;
                          -fx-font-size: 11px; -fx-font-weight: bold;
                          -fx-background-radius: 12;
                          -fx-padding: 2 8;
                          -fx-min-width: 24;"/>
        </StackPane>

        <Button text="🗑 Xóa tất cả" onAction="#handleClear"
                style="-fx-background-color: rgba(255,255,255,0.15);
                       -fx-text-fill: white; -fx-font-size: 11px;
                       -fx-background-radius: 8; -fx-cursor: hand;
                       -fx-border-color: rgba(255,255,255,0.4);
                       -fx-border-radius: 8; -fx-border-width: 1;
                       -fx-padding: 6 12;"/>
    </HBox>

    <!-- BODY -->
    <VBox spacing="0" VBox.vgrow="ALWAYS">
        <padding><Insets top="16" right="16" bottom="16" left="16"/></padding>

        <!-- Summary bar -->
        <HBox alignment="CENTER_LEFT" spacing="10"
              style="-fx-background-color: white;
                     -fx-background-radius: 12 12 0 0;
                     -fx-border-color: #E5E7EB;
                     -fx-border-radius: 12 12 0 0;
                     -fx-border-width: 1 1 0 1;
                     -fx-padding: 12 16;">
            <Label text="🔔"
                   style="-fx-font-size: 16px;"/>
            <VBox spacing="2">
                <Label text="Trung tâm thông báo"
                       style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #1F2937;"/>
                <Label text="Cập nhật realtime từ hệ thống đấu giá"
                       style="-fx-font-size: 11px; -fx-text-fill: #9CA3AF;"/>
            </VBox>
        </HBox>

        <!-- List -->
        <ListView fx:id="notificationList" VBox.vgrow="ALWAYS"
                  style="-fx-background-color: white;
                         -fx-border-color: #E5E7EB;
                         -fx-border-radius: 0 0 12 12;
                         -fx-border-width: 1;
                         -fx-background-radius: 0 0 12 12;
                         -fx-background-insets: 0;
                         -fx-padding: 4;">
            <placeholder>
                <VBox alignment="CENTER" spacing="14" style="-fx-padding: 60 0;">
                    <Label text="🔔"
                           style="-fx-font-size: 48px; -fx-opacity: 0.3;"/>
                    <Label text="Chưa có thông báo nào"
                           style="-fx-font-size: 14px; -fx-text-fill: #9CA3AF;
                                  -fx-font-weight: bold;"/>
                    <Label text="Thông báo sẽ xuất hiện khi có cập nhật giá,\nkết quả đấu giá hoặc giao dịch mới."
                           style="-fx-font-size: 12px; -fx-text-fill: #D1D5DB;
                                  -fx-text-alignment: center;"
                           wrapText="true"/>
                </VBox>
            </placeholder>
        </ListView>

    </VBox>

</VBox>
