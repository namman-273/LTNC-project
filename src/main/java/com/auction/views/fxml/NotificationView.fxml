<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.geometry.Insets?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.auction.controller.ui.NotificationController"
      prefWidth="560" prefHeight="640" spacing="0"
      stylesheets="@../style/style.css"
      style="-fx-background-color: #F5F6FA;">

    <!-- ═══ HEADER ═══════════════════════════════════════════════════════════ -->
    <HBox alignment="CENTER_LEFT" spacing="10"
          style="-fx-background-color: white;
                 -fx-padding: 14 20 14 16;
                 -fx-border-color: transparent transparent #EBEBEB transparent;
                 -fx-border-width: 1;">

        <!-- Back -->
        <Button text="←" onAction="#handleBack"
                style="-fx-background-color: #F5F6FA;
                       -fx-text-fill: #374151; -fx-font-size: 16px;
                       -fx-background-radius: 8; -fx-cursor: hand;
                       -fx-padding: 4 12; -fx-min-width: 36;"/>

        <!-- Bell icon circle -->
        <StackPane style="-fx-background-color: #FFF3E0;
                          -fx-background-radius: 22;
                          -fx-min-width: 44; -fx-min-height: 44;
                          -fx-max-width: 44; -fx-max-height: 44;">
            <Label text="🔔" style="-fx-font-size: 18px;"/>
        </StackPane>

        <VBox spacing="1">
            <Label text="Thông báo"
                   style="-fx-font-size: 17px; -fx-font-weight: bold; -fx-text-fill: #111827;"/>
            <Label fx:id="unreadCountLabel" text="3 thông báo mới"
                   style="-fx-font-size: 12px; -fx-text-fill: #6B7280;"/>
        </VBox>

        <Region HBox.hgrow="ALWAYS"/>

        <!-- Mark all -->
        <Button text="✓ Đánh dấu đã đọc tất cả" onAction="#handleMarkAll"
                style="-fx-background-color: transparent;
                       -fx-text-fill: #1565C0; -fx-font-size: 11px;
                       -fx-cursor: hand; -fx-padding: 5 10;
                       -fx-border-color: #DBEAFE; -fx-border-radius: 6;
                       -fx-background-radius: 6;"/>

        <!-- Clear read -->
        <Button text="🗑 Xóa đã đọc" onAction="#handleClearRead"
                style="-fx-background-color: transparent;
                       -fx-text-fill: #EF4444; -fx-font-size: 11px;
                       -fx-cursor: hand; -fx-padding: 5 10;
                       -fx-border-color: #FEE2E2; -fx-border-radius: 6;
                       -fx-background-radius: 6;"/>
    </HBox>

    <!-- ═══ TAB BAR ══════════════════════════════════════════════════════════ -->
    <HBox spacing="4" alignment="CENTER_LEFT"
          style="-fx-background-color: white;
                 -fx-padding: 0 16 0 16;
                 -fx-border-color: transparent transparent #EBEBEB transparent;
                 -fx-border-width: 1;">

        <Button fx:id="tabAll" text="Tất cả" onAction="#handleTabAll"
                style="-fx-background-color: #111827; -fx-text-fill: white;
                       -fx-font-weight: bold; -fx-background-radius: 20;
                       -fx-padding: 7 18; -fx-cursor: hand; -fx-font-size: 12px;"/>

        <Button fx:id="tabUnread" text="Chưa đọc" onAction="#handleTabUnread"
                style="-fx-background-color: transparent; -fx-text-fill: #6B7280;
                       -fx-background-radius: 20; -fx-padding: 7 18;
                       -fx-cursor: hand; -fx-font-size: 12px;"/>

        <Button fx:id="tabAuction" text="Đấu giá" onAction="#handleTabAuction"
                style="-fx-background-color: transparent; -fx-text-fill: #6B7280;
                       -fx-background-radius: 20; -fx-padding: 7 18;
                       -fx-cursor: hand; -fx-font-size: 12px;"/>

        <Button fx:id="tabSystem" text="Hệ thống" onAction="#handleTabSystem"
                style="-fx-background-color: transparent; -fx-text-fill: #6B7280;
                       -fx-background-radius: 20; -fx-padding: 7 18;
                       -fx-cursor: hand; -fx-font-size: 12px;"/>
    </HBox>

    <!-- ═══ LIST ══════════════════════════════════════════════════════════════ -->
    <ListView fx:id="notificationList" VBox.vgrow="ALWAYS"
              style="-fx-background-color: #F5F6FA;
                     -fx-border-color: transparent;
                     -fx-background-insets: 0;
                     -fx-padding: 12 14 12 14;">
        <placeholder>
            <VBox alignment="CENTER" spacing="16" style="-fx-padding: 80 0;">
                <StackPane style="-fx-background-color: #F3F4F6;
                                  -fx-background-radius: 40;
                                  -fx-min-width: 80; -fx-min-height: 80;
                                  -fx-max-width: 80; -fx-max-height: 80;">
                    <Label text="🔔" style="-fx-font-size: 32px; -fx-opacity: 0.4;"/>
                </StackPane>
                <Label text="Chưa có thông báo nào"
                       style="-fx-font-size: 15px; -fx-text-fill: #374151;
                              -fx-font-weight: bold;"/>
                <Label text="Thông báo sẽ hiện khi có cập nhật giá,&#10;kết quả đấu giá hoặc giao dịch mới."
                       style="-fx-font-size: 12px; -fx-text-fill: #9CA3AF;
                              -fx-text-alignment: center;"
                       wrapText="true"/>
            </VBox>
        </placeholder>
    </ListView>

</VBox>
