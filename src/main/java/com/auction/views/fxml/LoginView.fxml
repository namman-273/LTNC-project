<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.geometry.Insets?>

<HBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.auction.controller.ui.LoginController"
      prefWidth="760" prefHeight="520"
      stylesheets="@../style/style.css"
      style="-fx-background-color: #0F172A;">

    <!-- ══ CỘT TRÁI — branding ══════════════════════════════════════════════ -->
    <VBox prefWidth="320" prefHeight="520" alignment="CENTER" spacing="24"
          style="-fx-background-color: linear-gradient(to bottom, #0B1120, #1E2D45);
                 -fx-border-color: transparent #1E3A5F transparent transparent;
                 -fx-border-width: 1;">
        <padding><Insets top="56" right="36" bottom="56" left="36"/></padding>

        <!-- Logo -->
        <VBox alignment="CENTER" spacing="8">
            <Label text="🏛️"
                   style="-fx-font-size: 58px;
                          -fx-effect: dropshadow(gaussian, rgba(96,165,250,0.9), 28, 0, 0, 0);"/>
            <Label text="1388AUCTION"
                   style="-fx-font-size: 21px; -fx-font-weight: bold; -fx-text-fill: #93C5FD;
                          -fx-letter-spacing: 2px; -fx-effect: dropshadow(gaussian,rgba(59,130,246,0.5),4,0,0,0);"/>
            <Label text="Hệ thống đấu giá trực tuyến"
                   style="-fx-font-size: 11px; -fx-text-fill: #475569;"/>
        </VBox>

        <!-- Divider -->
        <Label style="-fx-border-color: #1E3A5F; -fx-border-width: 1 0 0 0;
                      -fx-min-height: 1; -fx-max-height: 1;" prefWidth="240"/>

        <!-- Features -->
        <VBox spacing="14" alignment="CENTER_LEFT">
            <HBox spacing="12" alignment="CENTER_LEFT">
                <Label text="✦"
                       style="-fx-text-fill: #3B82F6; -fx-font-size: 12px;"/>
                <Label text="Đấu giá trực tuyến minh bạch"
                       style="-fx-text-fill: #94A3B8; -fx-font-size: 12px;"/>
            </HBox>
            <HBox spacing="12" alignment="CENTER_LEFT">
                <Label text="✦"
                       style="-fx-text-fill: #3B82F6; -fx-font-size: 12px;"/>
                <Label text="Cập nhật giá realtime"
                       style="-fx-text-fill: #94A3B8; -fx-font-size: 12px;"/>
            </HBox>
            <HBox spacing="12" alignment="CENTER_LEFT">
                <Label text="✦"
                       style="-fx-text-fill: #3B82F6; -fx-font-size: 12px;"/>
                <Label text="Bảo mật và an toàn tuyệt đối"
                       style="-fx-text-fill: #94A3B8; -fx-font-size: 12px;"/>
            </HBox>
            <HBox spacing="12" alignment="CENTER_LEFT">
                <Label text="✦"
                       style="-fx-text-fill: #3B82F6; -fx-font-size: 12px;"/>
                <Label text="Hỗ trợ Auto-Bid thông minh"
                       style="-fx-text-fill: #94A3B8; -fx-font-size: 12px;"/>
            </HBox>
        </VBox>

        <Region VBox.vgrow="ALWAYS"/>

        <Label text="© 2026 1388AUCTION"
               style="-fx-font-size: 10px; -fx-text-fill: #334155;"/>
    </VBox>

    <!-- ══ CỘT PHẢI — form ══════════════════════════════════════════════════ -->
    <VBox prefWidth="440" prefHeight="520" alignment="CENTER" spacing="16"
          style="-fx-background-color: #0F172A;">
        <padding><Insets top="52" right="52" bottom="52" left="52"/></padding>

        <!-- Header -->
        <VBox alignment="CENTER_LEFT" spacing="4">
            <Label text="Chào mừng trở lại 👋"
                   style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #E2E8F0;"/>
            <Label text="Đăng nhập để tiếp tục đấu giá"
                   style="-fx-font-size: 12px; -fx-text-fill: #475569;"/>
        </VBox>

        <Region prefHeight="4"/>

        <!-- Username -->
        <VBox spacing="6">
            <Label text="Tên đăng nhập"
                   style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #94A3B8;"/>
            <TextField fx:id="usernameField" promptText="Nhập tên đăng nhập..."
                       prefHeight="44" prefWidth="336"
                       styleClass="text-field-modern"/>
        </VBox>

        <!-- Password -->
        <VBox spacing="6">
            <Label text="Mật khẩu"
                   style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #94A3B8;"/>
            <PasswordField fx:id="passwordField" promptText="••••••••"
                           prefHeight="44" prefWidth="336"
                           styleClass="text-field-modern"/>
        </VBox>

        <!-- Error / status -->
        <Label fx:id="errorLabel" text=""
               style="-fx-font-size: 12px; -fx-text-fill: #F87171;"
               wrapText="true" maxWidth="336"/>

        <!-- Login button -->
        <Button fx:id="loginButton" text="ĐĂNG NHẬP"
                prefWidth="336" prefHeight="46"
                onAction="#handleLogin"
                style="-fx-background-color: linear-gradient(to right,#1D4ED8,#3B82F6);
                       -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold;
                       -fx-background-radius: 12; -fx-cursor: hand;
                       -fx-effect: dropshadow(gaussian,rgba(59,130,246,0.7),14,0,0,4);"/>

        <!-- Register link -->
        <Button text="Chưa có tài khoản? Đăng ký ngay →"
                onAction="#handleRegister"
                prefWidth="336" prefHeight="38"
                style="-fx-background-color: rgba(59,130,246,0.1);
                       -fx-text-fill: #60A5FA;
                       -fx-font-size: 12px; -fx-cursor: hand;
                       -fx-background-radius: 10; -fx-font-weight: bold;
                       -fx-border-color: #1E3A5F; -fx-border-radius: 10;
                       -fx-border-width: 1;"/>
    </VBox>
</HBox>
