<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.geometry.Insets?>

<HBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.auction.controller.ui.AuctionListController"
      prefWidth="1280" prefHeight="760" spacing="0"
      stylesheets="@../style/style.css"
      style="-fx-background-color: #0F172A;">

    <!-- ══ SIDEBAR ════════════════════════════════════════════════════════════ -->
    <VBox prefWidth="220" spacing="0"
          style="-fx-background-color: #0B1120;
                 -fx-border-color: transparent #1E3A5F transparent transparent;
                 -fx-border-width: 1;">

        <!-- Logo / Brand -->
        <HBox alignment="CENTER_LEFT" spacing="10"
              style="-fx-padding: 20 16;
                     -fx-border-color: transparent transparent #1E3A5F transparent;
                     -fx-border-width: 1;">
            <Label text="🏛" style="-fx-font-size: 22px;"/>
            <VBox spacing="1">
                <Label text="1388AUCTION"
                       style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #60A5FA;"/>
                <Label text="Hệ thống đấu giá"
                       style="-fx-font-size: 9px; -fx-text-fill: #334155;"/>
            </VBox>
        </HBox>

        <!-- User Avatar / Welcome -->
        <VBox alignment="CENTER" spacing="6"
              style="-fx-padding: 14 16 12 16;
                     -fx-border-color: transparent transparent #1E3A5F transparent;
                     -fx-border-width: 1; -fx-background-color: rgba(30,45,69,0.5);">
            <Label text="👤"
                   style="-fx-font-size: 28px; -fx-background-color: #1E3A5F;
                          -fx-background-radius: 26; -fx-padding: 7 11;"/>
            <Label fx:id="welcomeLabel" text="Xin chào!"
                   style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #E2E8F0;
                          -fx-wrap-text: true;" maxWidth="188"/>
        </VBox>

        <!-- Nav Menu -->
        <VBox spacing="2" style="-fx-padding: 12 10;" VBox.vgrow="ALWAYS">

            <!-- Home (active) -->
            <Button text="🏠  Trang chủ"
                    prefWidth="200" prefHeight="40"
                    style="-fx-background-color: rgba(59,130,246,0.16); -fx-text-fill: #60A5FA;
                           -fx-font-size: 13px; -fx-font-weight: bold;
                           -fx-background-radius: 10; -fx-cursor: hand;
                           -fx-alignment: CENTER_LEFT; -fx-padding: 0 14;
                           -fx-border-color: transparent transparent transparent #3B82F6;
                           -fx-border-width: 0 0 0 3;"/>

            <Button text="📜  Lịch sử đấu giá" onAction="#handleBidHistory"
                    prefWidth="200" prefHeight="40"
                    style="-fx-background-color: transparent; -fx-text-fill: #64748B;
                           -fx-font-size: 13px; -fx-background-radius: 10; -fx-cursor: hand;
                           -fx-alignment: CENTER_LEFT; -fx-padding: 0 14;"/>

            <Button text="💰  Ví tiền" onAction="#handleBalance"
                    prefWidth="200" prefHeight="40"
                    style="-fx-background-color: transparent; -fx-text-fill: #64748B;
                           -fx-font-size: 13px; -fx-background-radius: 10; -fx-cursor: hand;
                           -fx-alignment: CENTER_LEFT; -fx-padding: 0 14;"/>

            <Button text="⭐  Watchlist" onAction="#handleGetWatchlist"
                    prefWidth="200" prefHeight="40"
                    style="-fx-background-color: transparent; -fx-text-fill: #64748B;
                           -fx-font-size: 13px; -fx-background-radius: 10; -fx-cursor: hand;
                           -fx-alignment: CENTER_LEFT; -fx-padding: 0 14;"/>

            <Button text="🔔  Thông báo" onAction="#handleNotification"
                    prefWidth="200" prefHeight="40"
                    style="-fx-background-color: transparent; -fx-text-fill: #64748B;
                           -fx-font-size: 13px; -fx-background-radius: 10; -fx-cursor: hand;
                           -fx-alignment: CENTER_LEFT; -fx-padding: 0 14;"/>

            <Button text="👤  Hồ sơ cá nhân" onAction="#handleProfile"
                    prefWidth="200" prefHeight="40"
                    style="-fx-background-color: transparent; -fx-text-fill: #64748B;
                           -fx-font-size: 13px; -fx-background-radius: 10; -fx-cursor: hand;
                           -fx-alignment: CENTER_LEFT; -fx-padding: 0 14;"/>

            <!-- Seller button (hidden for non-sellers, managed via controller) -->
            <Button fx:id="sellerButton" text="🏪  Quản lý bán hàng" onAction="#handleSellerDashboard"
                    prefWidth="200" prefHeight="40"
                    style="-fx-background-color: transparent; -fx-text-fill: #64748B;
                           -fx-font-size: 13px; -fx-background-radius: 10; -fx-cursor: hand;
                           -fx-alignment: CENTER_LEFT; -fx-padding: 0 14;"
                    visible="false" managed="false"/>

            <!-- Admin button (hidden for non-admins, managed via controller) -->
            <Button fx:id="adminButton" text="🛡  Admin Dashboard" onAction="#handleAdminDashboard"
                    prefWidth="200" prefHeight="40"
                    style="-fx-background-color: transparent; -fx-text-fill: #F59E0B;
                           -fx-font-size: 13px; -fx-background-radius: 10; -fx-cursor: hand;
                           -fx-alignment: CENTER_LEFT; -fx-padding: 0 14;"
                    visible="false" managed="false"/>

            <Region VBox.vgrow="ALWAYS"/>

            <!-- Separator -->
            <Label style="-fx-border-color: #1E3A5F; -fx-border-width: 1 0 0 0;
                          -fx-min-height: 1; -fx-max-height: 1;" prefWidth="200"/>

            <Button text="🚪  Đăng xuất" onAction="#handleLogout"
                    prefWidth="200" prefHeight="38"
                    style="-fx-background-color: transparent; -fx-text-fill: #F87171;
                           -fx-font-size: 13px; -fx-background-radius: 10; -fx-cursor: hand;
                           -fx-alignment: CENTER_LEFT; -fx-padding: 0 14;"/>
        </VBox>
    </VBox>

    <!-- ══ MAIN CONTENT ════════════════════════════════════════════════════════ -->
    <VBox HBox.hgrow="ALWAYS" spacing="0"
          style="-fx-background-color: #0F172A;">

        <!-- TOP HEADER BAR -->
        <HBox alignment="CENTER_LEFT" spacing="12"
              style="-fx-background-color: #0B1120;
                     -fx-padding: 0 24; -fx-pref-height: 56;
                     -fx-border-color: transparent transparent #1E3A5F transparent;
                     -fx-border-width: 1;">
            <Label text="🏛 Danh sách đấu giá"
                   style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #E2E8F0;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="➕ Tạo phiên" onAction="#handleCreateAuction"
                    style="-fx-background-color: #1565C0; -fx-text-fill: white;
                           -fx-font-size: 12px; -fx-font-weight: bold;
                           -fx-background-radius: 8; -fx-cursor: hand; -fx-padding: 7 16;"/>
            <Button text="🔄 Làm mới" onAction="#handleRefresh"
                    style="-fx-background-color: transparent; -fx-text-fill: #64748B;
                           -fx-font-size: 12px; -fx-background-radius: 8; -fx-cursor: hand;
                           -fx-padding: 7 16; -fx-border-color: #1E3A5F;
                           -fx-border-radius: 8; -fx-border-width: 1;"/>
        </HBox>

        <!-- FILTER BAR -->
        <HBox spacing="10" alignment="CENTER_LEFT"
              style="-fx-padding: 12 20;
                     -fx-background-color: #0B1120;
                     -fx-border-color: transparent transparent #1E3A5F transparent;
                     -fx-border-width: 1;">

            <!-- Type Filters -->
            <Label text="Loại:"
                   style="-fx-font-size: 12px; -fx-text-fill: #475569; -fx-font-weight: bold;"/>
            <Button fx:id="btnFilterAll" text="Tất cả" onAction="#handleFilterType"
                    prefHeight="30"
                    style="-fx-background-color: rgba(59,130,246,0.16); -fx-text-fill: #60A5FA;
                           -fx-font-size: 11px; -fx-font-weight: bold;
                           -fx-background-radius: 8; -fx-cursor: hand; -fx-padding: 0 14;"
                    styleClass="filter-active"/>
            <Button fx:id="btnFilterArt" text="🎨 Nghệ thuật" onAction="#handleFilterType"
                    prefHeight="30"
                    style="-fx-background-color: transparent; -fx-text-fill: #64748B;
                           -fx-font-size: 11px; -fx-background-radius: 8; -fx-cursor: hand;
                           -fx-padding: 0 14; -fx-border-color: #1E3A5F;
                           -fx-border-radius: 8; -fx-border-width: 1;"
                    styleClass="filter-btn"/>
            <Button fx:id="btnFilterElec" text="⚡ Điện tử" onAction="#handleFilterType"
                    prefHeight="30"
                    style="-fx-background-color: transparent; -fx-text-fill: #64748B;
                           -fx-font-size: 11px; -fx-background-radius: 8; -fx-cursor: hand;
                           -fx-padding: 0 14; -fx-border-color: #1E3A5F;
                           -fx-border-radius: 8; -fx-border-width: 1;"
                    styleClass="filter-btn"/>
            <Button fx:id="btnFilterVehicle" text="🚗 Xe cộ" onAction="#handleFilterType"
                    prefHeight="30"
                    style="-fx-background-color: transparent; -fx-text-fill: #64748B;
                           -fx-font-size: 11px; -fx-background-radius: 8; -fx-cursor: hand;
                           -fx-padding: 0 14; -fx-border-color: #1E3A5F;
                           -fx-border-radius: 8; -fx-border-width: 1;"
                    styleClass="filter-btn"/>
            <Button fx:id="btnFilterOther" text="🏷 Khác" onAction="#handleFilterType"
                    prefHeight="30"
                    style="-fx-background-color: transparent; -fx-text-fill: #64748B;
                           -fx-font-size: 11px; -fx-background-radius: 8; -fx-cursor: hand;
                           -fx-padding: 0 14; -fx-border-color: #1E3A5F;
                           -fx-border-radius: 8; -fx-border-width: 1;"
                    styleClass="filter-btn"/>

            <!-- Separator -->
            <Label style="-fx-border-color: #1E3A5F; -fx-border-width: 0 1 0 0;
                          -fx-min-width: 1; -fx-max-width: 1; -fx-min-height: 24;"/>

            <!-- Price Filters -->
            <Label text="Giá:"
                   style="-fx-font-size: 12px; -fx-text-fill: #475569; -fx-font-weight: bold;"/>
            <Button fx:id="btnPriceAll" text="Tất cả" onAction="#handleFilterPrice"
                    prefHeight="30"
                    style="-fx-background-color: rgba(59,130,246,0.16); -fx-text-fill: #60A5FA;
                           -fx-font-size: 11px; -fx-font-weight: bold;
                           -fx-background-radius: 8; -fx-cursor: hand; -fx-padding: 0 14;"
                    styleClass="filter-active"/>
            <Button fx:id="btnPriceUnder5" text="Dưới 5tr" onAction="#handleFilterPrice"
                    prefHeight="30"
                    style="-fx-background-color: transparent; -fx-text-fill: #64748B;
                           -fx-font-size: 11px; -fx-background-radius: 8; -fx-cursor: hand;
                           -fx-padding: 0 14; -fx-border-color: #1E3A5F;
                           -fx-border-radius: 8; -fx-border-width: 1;"
                    styleClass="filter-btn"/>
            <Button fx:id="btnPriceMid" text="5–50tr" onAction="#handleFilterPrice"
                    prefHeight="30"
                    style="-fx-background-color: transparent; -fx-text-fill: #64748B;
                           -fx-font-size: 11px; -fx-background-radius: 8; -fx-cursor: hand;
                           -fx-padding: 0 14; -fx-border-color: #1E3A5F;
                           -fx-border-radius: 8; -fx-border-width: 1;"
                    styleClass="filter-btn"/>
            <Button fx:id="btnPriceOver50" text="Trên 50tr" onAction="#handleFilterPrice"
                    prefHeight="30"
                    style="-fx-background-color: transparent; -fx-text-fill: #64748B;
                           -fx-font-size: 11px; -fx-background-radius: 8; -fx-cursor: hand;
                           -fx-padding: 0 14; -fx-border-color: #1E3A5F;
                           -fx-border-radius: 8; -fx-border-width: 1;"
                    styleClass="filter-btn"/>

            <Region HBox.hgrow="ALWAYS"/>

            <!-- Watchlist Action Buttons -->
            <Button text="👁  Theo dõi" onAction="#handleWatch"
                    prefHeight="30"
                    style="-fx-background-color: rgba(5,150,105,0.15); -fx-text-fill: #34D399;
                           -fx-font-size: 11px; -fx-font-weight: bold;
                           -fx-background-radius: 8; -fx-cursor: hand;
                           -fx-padding: 0 14; -fx-border-color: #065F46;
                           -fx-border-radius: 8; -fx-border-width: 1;"/>
            <Button text="✖  Bỏ theo dõi" onAction="#handleUnwatch"
                    prefHeight="30"
                    style="-fx-background-color: rgba(239,68,68,0.12); -fx-text-fill: #F87171;
                           -fx-font-size: 11px; -fx-font-weight: bold;
                           -fx-background-radius: 8; -fx-cursor: hand;
                           -fx-padding: 0 14; -fx-border-color: #7F1D1D;
                           -fx-border-radius: 8; -fx-border-width: 1;"/>
        </HBox>

        <!-- AUCTION GRID (ScrollPane wrapping FlowPane) -->
        <ScrollPane HBox.hgrow="ALWAYS" VBox.vgrow="ALWAYS" fitToWidth="true"
                    style="-fx-background: transparent; -fx-background-color: transparent;
                           -fx-border-color: transparent;">
            <FlowPane fx:id="auctionGrid"
                      hgap="16" vgap="16"
                      style="-fx-padding: 20 20; -fx-background-color: #0F172A;"/>
        </ScrollPane>

        <!-- STATUS BAR -->
        <HBox alignment="CENTER_LEFT" spacing="8"
              style="-fx-padding: 8 20;
                     -fx-background-color: #0B1120;
                     -fx-border-color: #1E3A5F transparent transparent transparent;
                     -fx-border-width: 1;">
            <Label fx:id="statusBarLabel" text="Đang tải danh sách phiên..."
                   style="-fx-font-size: 11px; -fx-text-fill: #475569;"/>
        </HBox>

    </VBox>

</HBox>
