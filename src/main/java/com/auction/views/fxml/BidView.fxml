<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.image.ImageView?>

<StackPane xmlns:fx="http://javafx.com/fxml"
           fx:controller="com.auction.controller.ui.BidController"
           fx:id="rootPane"
           prefWidth="1060" prefHeight="720"
           stylesheets="@../style/style.css"
           style="-fx-background-color: #0F172A;">

    <HBox spacing="0" style="-fx-background-color: #0F172A;">

        <!-- ═══════════════ CỘT TRÁI ═══════════════ -->
        <ScrollPane fitToWidth="true" HBox.hgrow="ALWAYS"
                    style="-fx-background-color: transparent; -fx-background: #0F172A;
                           -fx-border-color: transparent;">
            <VBox spacing="0" style="-fx-background-color: #0F172A;">

                <!-- Breadcrumb -->
                <HBox alignment="CENTER_LEFT" spacing="0"
                      style="-fx-background-color: #0B1120; -fx-padding: 12 24;
                             -fx-border-color: transparent transparent #1E3A5F transparent;
                             -fx-border-width: 1;">
                    <Button text="← Quay lại danh sách" onAction="#handleBack"
                            style="-fx-background-color: transparent; -fx-text-fill: #60A5FA;
                                   -fx-font-size: 13px; -fx-cursor: hand; -fx-padding: 4 0;
                                   -fx-border-color: transparent;"/>
                    <Label text=" / " style="-fx-font-size: 13px; -fx-text-fill: #334155;"/>
                    <Label fx:id="auctionTitleLabel" text="Đấu giá"
                           style="-fx-font-size: 13px; -fx-text-fill: #E2E8F0; -fx-font-weight: bold;"/>
                </HBox>

                <!-- Ảnh sản phẩm -->
                <VBox style="-fx-padding: 20 24 0 24;">
                    <StackPane style="-fx-background-color: #162236;
                                      -fx-background-radius: 14;
                                      -fx-pref-height: 260; -fx-min-height: 260;
                                      -fx-border-color: #1E3A5F; -fx-border-radius: 14;
                                      -fx-border-width: 1;">
                        <VBox fx:id="imagePlaceholder" alignment="CENTER" spacing="8">
                            <Label text="🖼" style="-fx-font-size: 52px; -fx-opacity: 0.3;"/>
                            <Label text="Không có ảnh sản phẩm"
                                   style="-fx-font-size: 12px; -fx-text-fill: #334155;"/>
                        </VBox>
                        <ImageView fx:id="productImage"
                                   fitWidth="460" fitHeight="260"
                                   preserveRatio="false" smooth="true"
                                   visible="false" managed="false"/>
                        <Label fx:id="itemTypeLabel" text="Sản phẩm"
                               style="-fx-background-color: #2563EB; -fx-text-fill: white;
                                      -fx-font-size: 11px; -fx-font-weight: bold;
                                      -fx-background-radius: 6; -fx-padding: 4 10;"
                               StackPane.alignment="TOP_LEFT"
                               translateX="12" translateY="12"/>
                    </StackPane>
                </VBox>

                <!-- Toggle chi tiết -->
                <VBox style="-fx-padding: 10 24 0 24;">
                    <Button fx:id="toggleDetailBtn" text="▼ Xem chi tiết sản phẩm"
                            onAction="#handleToggleDetail"
                            maxWidth="Infinity"
                            style="-fx-background-color: #162236; -fx-text-fill: #60A5FA;
                                   -fx-font-size: 12px; -fx-font-weight: bold;
                                   -fx-background-radius: 8; -fx-cursor: hand;
                                   -fx-padding: 9 16; -fx-alignment: CENTER;
                                   -fx-border-color: #1E3A5F; -fx-border-radius: 8; -fx-border-width: 1;"/>
                </VBox>

                <!-- Panel chi tiết -->
                <VBox fx:id="productDetailPanel" spacing="12" visible="false" managed="false"
                      style="-fx-background-color: #162236; -fx-background-radius: 12;
                             -fx-border-color: #1E3A5F; -fx-border-radius: 12;
                             -fx-border-width: 1; -fx-padding: 16;">
                    <VBox.margin><Insets top="10" right="24" bottom="0" left="24"/></VBox.margin>
                    <Label text="📦 Thông tin sản phẩm"
                           style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #E2E8F0;"/>
                    <HBox spacing="0">
                        <VBox spacing="4" HBox.hgrow="ALWAYS">
                            <Label text="Loại sản phẩm"
                                   style="-fx-font-size: 10px; -fx-text-fill: #475569;"/>
                            <Label fx:id="detailItemType" text="—"
                                   style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #E2E8F0;"/>
                        </VBox>
                        <VBox spacing="4" HBox.hgrow="ALWAYS">
                            <Label text="Giá khởi điểm"
                                   style="-fx-font-size: 10px; -fx-text-fill: #475569;"/>
                            <Label fx:id="detailStartPrice" text="—"
                                   style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #60A5FA;"/>
                        </VBox>
                        <VBox spacing="4" HBox.hgrow="ALWAYS">
                            <Label text="Người bán"
                                   style="-fx-font-size: 10px; -fx-text-fill: #475569;"/>
                            <Label fx:id="detailSeller" text="—"
                                   style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #E2E8F0;"/>
                        </VBox>
                    </HBox>
                </VBox>

                <!-- Mô tả -->
                <VBox fx:id="descriptionBox" spacing="6" visible="false" managed="false"
                      style="-fx-padding: 12 24 0 24;">
                    <Label text="📝 Mô tả sản phẩm"
                           style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #E2E8F0;"/>
                    <Label fx:id="descriptionLabel" text=""
                           style="-fx-font-size: 12px; -fx-text-fill: #64748B; -fx-wrap-text: true;"
                           wrapText="true" maxWidth="500"/>
                </VBox>

                <!-- Tên + trạng thái -->
                <VBox spacing="4" style="-fx-padding: 16 24 0 24;">
                    <Label fx:id="itemNameLabel" text="---"
                           style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #E2E8F0;
                                  -fx-wrap-text: true;"/>
                    <Label fx:id="statusLabel" text="OPEN"
                           style="-fx-font-size: 11px; -fx-text-fill: #34D399; -fx-font-weight: bold;"/>
                </VBox>

                <!-- Lịch sử đặt giá -->
                <VBox spacing="10" style="-fx-padding: 16 24 24 24;">
                    <Label text="📋 Lịch sử đặt giá"
                           style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #E2E8F0;"/>
                    <VBox fx:id="historyContainer" spacing="0"
                          style="-fx-background-color: #162236; -fx-background-radius: 12;
                                 -fx-border-color: #1E3A5F; -fx-border-radius: 12;
                                 -fx-border-width: 1; -fx-min-height: 200;">
                        <ListView fx:id="bidHistoryList" prefHeight="220"
                                  style="-fx-background-color: transparent; -fx-border-color: transparent;
                                         -fx-background-insets: 0; -fx-padding: 4;"/>
                    </VBox>
                </VBox>

            </VBox>
        </ScrollPane>

        <!-- ═══════════════ CỘT PHẢI ═══════════════ -->
        <VBox prefWidth="390" spacing="0"
              style="-fx-background-color: #0B1120;
                     -fx-border-color: transparent transparent transparent #1E3A5F;
                     -fx-border-width: 1;">

            <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS"
                        style="-fx-background-color: transparent; -fx-background: #0B1120;
                               -fx-border-color: transparent;">
                <VBox spacing="14" style="-fx-padding: 20; -fx-background-color: #0B1120;">

                    <!-- Countdown -->
                    <VBox spacing="6" alignment="CENTER"
                          style="-fx-background-color: #162236; -fx-background-radius: 12;
                                 -fx-border-color: #1E3A5F; -fx-border-radius: 12;
                                 -fx-border-width: 1; -fx-padding: 14;">
                        <Label text="Thời gian còn lại"
                               style="-fx-font-size: 11px; -fx-text-fill: #475569;"/>
                        <Label fx:id="countdownLabel" text="00 : 00 : 00"
                               style="-fx-font-size: 28px; -fx-font-weight: bold;
                                      -fx-text-fill: #FBBF24; -fx-font-family: monospace;"/>
                        <HBox alignment="CENTER" spacing="26">
                            <Label text="Giờ"  style="-fx-font-size: 10px; -fx-text-fill: #475569;"/>
                            <Label text="Phút" style="-fx-font-size: 10px; -fx-text-fill: #475569;"/>
                            <Label text="Giây" style="-fx-font-size: 10px; -fx-text-fill: #475569;"/>
                        </HBox>
                    </VBox>

                    <!-- Giá hiện tại + số dư ví -->
                    <HBox spacing="10">
                        <!-- Giá hiện tại -->
                        <VBox spacing="4" HBox.hgrow="ALWAYS"
                              style="-fx-background-color: #162236; -fx-background-radius: 12;
                                     -fx-border-color: #1E3A5F; -fx-border-radius: 12;
                                     -fx-border-width: 1; -fx-padding: 14;">
                            <Label text="Giá hiện tại"
                                   style="-fx-font-size: 11px; -fx-text-fill: #475569;"/>
                            <Label fx:id="currentPriceLabel" text="---"
                                   style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #60A5FA;"/>
                        </VBox>
                        <!-- Số dư ví -->
                        <VBox spacing="4" HBox.hgrow="ALWAYS"
                              style="-fx-background-color: rgba(5,150,105,0.12); -fx-background-radius: 12;
                                     -fx-border-color: #1E3A5F; -fx-border-radius: 12;
                                     -fx-border-width: 1; -fx-padding: 14;">
                            <Label text="💰 Số dư ví"
                                   style="-fx-font-size: 11px; -fx-text-fill: #475569;"/>
                            <Label fx:id="balanceLabel" text="---"
                                   style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #34D399;"
                                   wrapText="true"/>
                        </VBox>
                    </HBox>

                    <!-- SNIPING ALERT -->
                    <VBox fx:id="snipingBox" spacing="6" visible="false" managed="false"
                          style="-fx-background-color: rgba(251,191,36,0.1); -fx-background-radius: 12;
                                 -fx-border-color: #FBBF24; -fx-border-radius: 12;
                                 -fx-border-width: 1.5; -fx-padding: 14;">
                        <Label text="⏱ Phiên vừa được gia hạn!"
                               style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #FBBF24;"/>
                        <Label fx:id="snipingCountdownLabel" text="⏱ +2 phút vừa được cộng thêm!"
                               style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #F59E0B;"/>
                        <Label fx:id="snipingCountLabel" text=""
                               style="-fx-font-size: 11px; -fx-text-fill: #FBBF24;"/>
                    </VBox>

                    <!-- Đặt giá -->
                    <VBox spacing="12"
                          style="-fx-background-color: #162236; -fx-background-radius: 12;
                                 -fx-border-color: #1E3A5F; -fx-border-radius: 12;
                                 -fx-border-width: 1; -fx-padding: 16;">
                        <Label text="🔨 Đặt giá đầu"
                               style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #E2E8F0;"/>
                        <VBox spacing="6">
                            <Label text="Nhập giá của bạn (VND):"
                                   style="-fx-font-size: 12px; -fx-text-fill: #64748B;"/>
                            <TextField fx:id="bidAmountField" promptText="Gợi ý: 1,050,000"
                                       prefHeight="44"
                                       styleClass="text-field-modern"
                                       style="-fx-font-size: 14px;"/>
                            <Label text="Giá đặt phải cao hơn giá hiện tại"
                                   style="-fx-font-size: 11px; -fx-text-fill: #334155;"/>
                        </VBox>
                        <HBox spacing="8">
                            <Button text="+1M" onAction="#handleAdd1M"
                                    HBox.hgrow="ALWAYS" prefHeight="36"
                                    style="-fx-background-color: #1E2D45; -fx-text-fill: #94A3B8;
                                           -fx-font-size: 12px; -fx-font-weight: bold;
                                           -fx-background-radius: 8; -fx-cursor: hand;
                                           -fx-border-color: #1E3A5F; -fx-border-radius: 8; -fx-border-width: 1;"/>
                            <Button text="+5M" onAction="#handleAdd5M"
                                    HBox.hgrow="ALWAYS" prefHeight="36"
                                    style="-fx-background-color: #1E2D45; -fx-text-fill: #94A3B8;
                                           -fx-font-size: 12px; -fx-font-weight: bold;
                                           -fx-background-radius: 8; -fx-cursor: hand;
                                           -fx-border-color: #1E3A5F; -fx-border-radius: 8; -fx-border-width: 1;"/>
                            <Button text="+10M" onAction="#handleAdd10M"
                                    HBox.hgrow="ALWAYS" prefHeight="36"
                                    style="-fx-background-color: #1E2D45; -fx-text-fill: #94A3B8;
                                           -fx-font-size: 12px; -fx-font-weight: bold;
                                           -fx-background-radius: 8; -fx-cursor: hand;
                                           -fx-border-color: #1E3A5F; -fx-border-radius: 8; -fx-border-width: 1;"/>
                        </HBox>
                        <Button text="🔨 ĐẶT GIÁ NGAY" onAction="#handleBid"
                                prefWidth="350" prefHeight="48"
                                style="-fx-background-color: linear-gradient(to right, #DC2626, #EF4444);
                                       -fx-text-fill: white;
                                       -fx-font-size: 15px; -fx-font-weight: bold;
                                       -fx-background-radius: 10; -fx-cursor: hand;
                                       -fx-effect: dropshadow(gaussian, rgba(220,38,38,0.5), 10, 0, 0, 3);"/>
                        <Label fx:id="messageLabel" text=""
                               style="-fx-font-size: 12px; -fx-min-height: 18px;"/>
                    </VBox>

                    <!-- Tính năng nâng cao -->
                    <VBox spacing="10"
                          style="-fx-background-color: #162236; -fx-background-radius: 12;
                                 -fx-border-color: #1E3A5F; -fx-border-radius: 12;
                                 -fx-border-width: 1; -fx-padding: 16;">
                        <Label text="⚡ Tính năng nâng cao"
                               style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #E2E8F0;"/>
                        <Button text="📊 Xem biểu đồ giá" onAction="#handleViewChart"
                                prefWidth="350" prefHeight="40"
                                style="-fx-background-color: #1E2D45; -fx-text-fill: #60A5FA;
                                       -fx-font-size: 12px; -fx-font-weight: bold;
                                       -fx-background-radius: 8; -fx-cursor: hand;
                                       -fx-border-color: #2563EB; -fx-border-radius: 8; -fx-border-width: 1.5;"/>
                        <Button text="🤖 Quản lý Auto-Bid" onAction="#handleAutoBid"
                                prefWidth="350" prefHeight="40"
                                style="-fx-background-color: linear-gradient(to right,#1D4ED8,#2563EB);
                                       -fx-text-fill: white;
                                       -fx-font-size: 12px; -fx-font-weight: bold;
                                       -fx-background-radius: 8; -fx-cursor: hand;
                                       -fx-effect: dropshadow(gaussian, rgba(37,99,235,0.4), 6, 0, 0, 2);"/>
                    </VBox>

                    <!-- Người bán -->
                    <VBox spacing="8"
                          style="-fx-background-color: #162236; -fx-background-radius: 12;
                                 -fx-border-color: #1E3A5F; -fx-border-radius: 12;
                                 -fx-border-width: 1; -fx-padding: 16;">
                        <Label text="👤 Người bán"
                               style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #E2E8F0;"/>
                        <HBox spacing="12" alignment="CENTER_LEFT">
                            <Label text="AG"
                                   style="-fx-background-color: #2563EB; -fx-text-fill: white;
                                          -fx-font-size: 14px; -fx-font-weight: bold;
                                          -fx-background-radius: 20; -fx-padding: 8 12;"/>
                            <VBox spacing="2">
                                <Label fx:id="sellerLabel" text="Người bán"
                                       style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #E2E8F0;"/>
                                <Label text="✓ Đã xác minh"
                                       style="-fx-font-size: 11px; -fx-text-fill: #34D399;"/>
                            </VBox>
                        </HBox>
                    </VBox>

                    <!-- Hướng dẫn -->
                    <VBox spacing="6"
                          style="-fx-background-color: rgba(5,150,105,0.08); -fx-background-radius: 12;
                                 -fx-border-color: rgba(52,211,153,0.25); -fx-border-radius: 12;
                                 -fx-border-width: 1; -fx-padding: 14;">
                        <Label text="💡 Hướng dẫn"
                               style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #34D399;"/>
                        <Label text="• Nhập giá cao hơn giá hiện tại"
                               style="-fx-font-size: 11px; -fx-text-fill: #6EE7B7;" wrapText="true"/>
                        <Label text="• Giá cập nhật tự động realtime"
                               style="-fx-font-size: 11px; -fx-text-fill: #6EE7B7;" wrapText="true"/>
                        <Label text="• Người đặt cao nhất khi hết giờ thắng"
                               style="-fx-font-size: 11px; -fx-text-fill: #6EE7B7;" wrapText="true"/>
                        <Label text="• Tiền tạm giữ, hoàn nếu bị vượt giá"
                               style="-fx-font-size: 11px; -fx-text-fill: #6EE7B7;" wrapText="true"/>
                    </VBox>

                </VBox>
            </ScrollPane>
        </VBox>

    </HBox>

</StackPane>
