<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.geometry.Insets?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.auction.controller.ui.SellerController"
      prefWidth="860" prefHeight="600" spacing="0"
      stylesheets="@../style/style.css"
      style="-fx-background-color: #F8F9FA;">

    <!-- HEADER -->
    <HBox alignment="CENTER_LEFT" spacing="14"
          style="-fx-background-color: linear-gradient(to right, #1565C0, #2196F3);
                 -fx-padding: 0 24; -fx-pref-height: 64;
                 -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.2), 8, 0, 0, 3);">

        <HBox spacing="10" alignment="CENTER_LEFT">
            <Label text="🏛️" style="-fx-font-size: 22px;"/>
            <VBox spacing="1">
                <Label text="HỆ THỐNG ĐẤU GIÁ"
                       style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: white;"/>
                <Label text="1388AUCTION System - Seller Dashboard"
                       style="-fx-font-size: 9px; -fx-text-fill: #90CAF9;"/>
            </VBox>
        </HBox>

        <Region HBox.hgrow="ALWAYS"/>

        <Label fx:id="welcomeLabel" text="Xin chào!"
               style="-fx-font-size: 13px; -fx-text-fill: #E3F2FD;"/>

        <Button text="← Quay lại" onAction="#handleBack"
                style="-fx-background-color: rgba(255,255,255,0.15);
                       -fx-text-fill: white; -fx-font-size: 12px;
                       -fx-background-radius: 8; -fx-cursor: hand;
                       -fx-border-color: rgba(255,255,255,0.4);
                       -fx-border-radius: 8; -fx-border-width: 1;
                       -fx-padding: 6 14;"/>
    </HBox>

    <!-- TOOLBAR -->
    <HBox alignment="CENTER_LEFT" spacing="10"
          style="-fx-background-color: white; -fx-padding: 12 24;
                 -fx-border-color: transparent transparent #EEEEEE transparent;
                 -fx-border-width: 1;">

        <VBox spacing="2">
            <Label text="Quản lý phiên đấu giá"
                   style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #1565C0;"/>
            <Label fx:id="statsLabel" text="Đang tải..."
                   style="-fx-font-size: 11px; -fx-text-fill: #AAAAAA;"/>
        </VBox>

        <Region HBox.hgrow="ALWAYS"/>

        <Button text="➕ Tạo phiên mới" onAction="#handleCreateAuction"
                prefHeight="36" prefWidth="130"
                styleClass="btn-primary"/>
    </HBox>

    <!-- CONTENT: bảng + lịch sử -->
    <HBox spacing="16" VBox.vgrow="ALWAYS">
        <padding><Insets top="16" right="20" bottom="16" left="20"/></padding>

        <!-- TRÁI: bảng phiên -->
        <VBox spacing="8" prefWidth="480" VBox.vgrow="ALWAYS">
            <Label text="📦 Danh sách phiên của tôi"
                   style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #1565C0;"/>
            <TableView fx:id="auctionTable" VBox.vgrow="ALWAYS"
                       styleClass="table-view">
                <columns>
                    <TableColumn fx:id="idCol" text="ID Phiên" prefWidth="160"/>
                    <TableColumn fx:id="nameCol" text="Tên sản phẩm" prefWidth="140"/>
                    <TableColumn fx:id="priceCol" text="Giá hiện tại" prefWidth="110"/>
                    <TableColumn fx:id="statusCol" text="Trạng thái" prefWidth="90"/>
                </columns>
                <placeholder>
                    <Label text="Chưa có phiên nào. Nhấn Tạo phiên mới."
                           style="-fx-text-fill: #AAAAAA;"/>
                </placeholder>
            </TableView>
        </VBox>

        <!-- PHẢI: lịch sử đặt giá -->
        <VBox spacing="8" prefWidth="320" VBox.vgrow="ALWAYS">
            <Label fx:id="historyTitleLabel" text="📋 Lịch sử đặt giá"
                   style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #1565C0;"/>
            <Label text="← Chọn một phiên để xem lịch sử"
                   style="-fx-font-size: 11px; -fx-text-fill: #AAAAAA;"/>
            <ListView fx:id="historyList" VBox.vgrow="ALWAYS"
                      styleClass="list-view"/>
            <Label fx:id="messageLabel" text=""
                   style="-fx-font-size: 12px;" wrapText="true"/>
        </VBox>

    </HBox>

</VBox>
