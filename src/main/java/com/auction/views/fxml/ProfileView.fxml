<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.geometry.Insets?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.auction.controller.ui.ProfileController"
      prefWidth="520" prefHeight="680" spacing="0"
      stylesheets="@../style/style.css"
      style="-fx-background-color: #F5F6FA;">

    <!-- HEADER -->
    <HBox alignment="CENTER_LEFT" spacing="12"
          style="-fx-background-color: #1565C0;
                 -fx-padding: 0 20; -fx-pref-height: 56;">
        <Button text="←" onAction="#handleBack"
                style="-fx-background-color: rgba(255,255,255,0.15);
                       -fx-text-fill: white; -fx-font-size: 16px;
                       -fx-background-radius: 8; -fx-cursor: hand;
                       -fx-padding: 4 12;"/>
        <Label text="🏛 Hồ sơ cá nhân"
               style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: white;"/>
    </HBox>

    <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS"
                style="-fx-background-color: transparent; -fx-background: transparent;
                       -fx-border-color: transparent;">
        <VBox spacing="10" style="-fx-padding: 14;">

            <!-- AVATAR CARD -->
            <HBox spacing="14" alignment="CENTER_LEFT"
                  style="-fx-background-color: white; -fx-background-radius: 14;
                         -fx-padding: 16 20;
                         -fx-border-color: #EEEEEE; -fx-border-radius: 14; -fx-border-width: 0.5;">
                <StackPane style="-fx-background-color: #1565C0; -fx-background-radius: 30;
                                  -fx-min-width: 52; -fx-min-height: 52;
                                  -fx-max-width: 52; -fx-max-height: 52;">
                    <Label fx:id="avatarLabel" text="U"
                           style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: white;"/>
                </StackPane>
                <VBox spacing="4">
                    <HBox spacing="8" alignment="CENTER_LEFT">
                        <Label fx:id="usernameLabel" text="username"
                               style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #111827;"/>
                        <Label fx:id="roleLabel" text="BIDDER"
                               style="-fx-background-color: #DBEAFE; -fx-text-fill: #1D4ED8;
                                      -fx-font-size: 10px; -fx-font-weight: bold;
                                      -fx-background-radius: 10; -fx-padding: 2 8;"/>
                    </HBox>
                    <Label fx:id="balanceLabel" text="Số dư: 0 VNĐ"
                           style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #1565C0;"/>
                </VBox>
            </HBox>

            <!-- THÔNG TIN CÁ NHÂN -->
            <VBox spacing="0"
                  style="-fx-background-color: white; -fx-background-radius: 14;
                         -fx-border-color: #EEEEEE; -fx-border-radius: 14; -fx-border-width: 0.5;">

                <HBox alignment="CENTER_LEFT" style="-fx-padding: 12 16 8 16;">
                    <Label text="Thông tin cá nhân"
                           style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #6B7280;"/>
                </HBox>

                <!-- Tên đăng nhập -->
                <HBox alignment="CENTER_LEFT" spacing="12"
                      style="-fx-padding: 10 16;
                             -fx-border-color: #F3F4F6 transparent transparent transparent;
                             -fx-border-width: 1;">
                    <VBox spacing="2" HBox.hgrow="ALWAYS">
                        <Label text="Tên đăng nhập"
                               style="-fx-font-size: 11px; -fx-text-fill: #9CA3AF;"/>
                        <Label fx:id="usernameFieldLabel" text="—"
                               style="-fx-font-size: 13px; -fx-text-fill: #374151;"/>
                    </VBox>
                    <Label text="Không đổi được"
                           style="-fx-font-size: 11px; -fx-text-fill: #D1D5DB;
                                  -fx-background-color: #F9FAFB; -fx-background-radius: 6;
                                  -fx-padding: 4 10;"/>
                </HBox>

                <!-- Email -->
                <HBox alignment="CENTER_LEFT" spacing="12"
                      style="-fx-padding: 10 16;
                             -fx-border-color: #F3F4F6 transparent transparent transparent;
                             -fx-border-width: 1;">
                    <VBox spacing="4" HBox.hgrow="ALWAYS">
                        <Label text="Email"
                               style="-fx-font-size: 11px; -fx-text-fill: #9CA3AF;"/>
                        <TextField fx:id="emailField" promptText="Nhập email..."
                                   prefHeight="32"
                                   style="-fx-font-size: 12px; -fx-background-color: #F9FAFB;
                                          -fx-border-color: #E5E7EB; -fx-border-radius: 6;
                                          -fx-background-radius: 6; -fx-padding: 5 10;"/>
                    </VBox>
                    <Button text="Sửa" onAction="#handleUpdateEmail"
                            style="-fx-background-color: white; -fx-text-fill: #1565C0;
                                   -fx-font-size: 11px; -fx-font-weight: bold;
                                   -fx-background-radius: 8; -fx-cursor: hand;
                                   -fx-padding: 6 14; -fx-border-color: #BFDBFE;
                                   -fx-border-radius: 8; -fx-border-width: 1;"/>
                </HBox>

                <!-- Mật khẩu -->
                <VBox style="-fx-border-color: #F3F4F6 transparent transparent transparent;
                             -fx-border-width: 1;">
                    <HBox alignment="CENTER_LEFT" spacing="12" style="-fx-padding: 10 16;">
                        <VBox spacing="2" HBox.hgrow="ALWAYS">
                            <Label text="Mật khẩu"
                                   style="-fx-font-size: 11px; -fx-text-fill: #9CA3AF;"/>
                            <Label text="••••••••"
                                   style="-fx-font-size: 14px; -fx-text-fill: #374151;"/>
                        </VBox>
                        <Button text="Đổi" onAction="#handleChangePassword"
                                style="-fx-background-color: white; -fx-text-fill: #1565C0;
                                       -fx-font-size: 11px; -fx-font-weight: bold;
                                       -fx-background-radius: 8; -fx-cursor: hand;
                                       -fx-padding: 6 14; -fx-border-color: #BFDBFE;
                                       -fx-border-radius: 8; -fx-border-width: 1;"/>
                    </HBox>

                    <!-- Panel đổi mật khẩu -->
                    <VBox fx:id="passwordPanel" spacing="8" visible="false" managed="false"
                          style="-fx-background-color: #F8FAFF; -fx-padding: 12 16;
                                 -fx-border-color: #E0E7FF transparent transparent transparent;
                                 -fx-border-width: 1;">
                        <PasswordField fx:id="oldPasswordField" promptText="Mật khẩu hiện tại"
                                       prefHeight="34"
                                       style="-fx-font-size: 12px; -fx-background-color: white;
                                              -fx-border-color: #E5E7EB; -fx-border-radius: 7;
                                              -fx-background-radius: 7;"/>
                        <PasswordField fx:id="newPasswordField" promptText="Mật khẩu mới (ít nhất 6 ký tự)"
                                       prefHeight="34"
                                       style="-fx-font-size: 12px; -fx-background-color: white;
                                              -fx-border-color: #E5E7EB; -fx-border-radius: 7;
                                              -fx-background-radius: 7;"/>
                        <PasswordField fx:id="confirmPasswordField" promptText="Xác nhận mật khẩu mới"
                                       prefHeight="34"
                                       style="-fx-font-size: 12px; -fx-background-color: white;
                                              -fx-border-color: #E5E7EB; -fx-border-radius: 7;
                                              -fx-background-radius: 7;"/>
                        <Button text="Xác nhận đổi mật khẩu" onAction="#handleConfirmChangePassword"
                                maxWidth="Infinity" prefHeight="36"
                                style="-fx-background-color: #1565C0; -fx-text-fill: white;
                                       -fx-font-size: 12px; -fx-font-weight: bold;
                                       -fx-background-radius: 8; -fx-cursor: hand;"/>
                    </VBox>
                </VBox>

                <!-- Vai trò -->
                <HBox alignment="CENTER_LEFT"
                      style="-fx-padding: 10 16;
                             -fx-border-color: #F3F4F6 transparent transparent transparent;
                             -fx-border-width: 1;">
                    <VBox spacing="2">
                        <Label text="Vai trò"
                               style="-fx-font-size: 11px; -fx-text-fill: #9CA3AF;"/>
                        <Label fx:id="roleDetailLabel" text="—"
                               style="-fx-font-size: 13px; -fx-text-fill: #374151;"/>
                    </VBox>
                </HBox>

                <!-- Ngày tham gia -->
                <HBox alignment="CENTER_LEFT"
                      style="-fx-padding: 10 16;
                             -fx-border-color: #F3F4F6 transparent transparent transparent;
                             -fx-border-width: 1;">
                    <VBox spacing="2">
                        <Label text="Ngày tham gia"
                               style="-fx-font-size: 11px; -fx-text-fill: #9CA3AF;"/>
                        <Label fx:id="joinDateLabel" text="—"
                               style="-fx-font-size: 13px; -fx-text-fill: #374151;"/>
                    </VBox>
                </HBox>
            </VBox>

            <!-- THỐNG KÊ 2x2 -->
            <VBox spacing="0"
                  style="-fx-background-color: white; -fx-background-radius: 14;
                         -fx-border-color: #EEEEEE; -fx-border-radius: 14; -fx-border-width: 0.5;">
                <HBox alignment="CENTER_LEFT" style="-fx-padding: 12 16 8 16;">
                    <Label text="Thống kê hoạt động"
                           style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #6B7280;"/>
                </HBox>
                <GridPane>
                    <!-- Row 1 -->
                    <VBox alignment="CENTER" spacing="4" GridPane.columnIndex="0" GridPane.rowIndex="0"
                          style="-fx-padding: 14 0;
                                 -fx-border-color: #F3F4F6 #F3F4F6 #F3F4F6 transparent;
                                 -fx-border-width: 1;" prefWidth="240">
                        <Label fx:id="statTotal" text="0"
                               style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #1565C0;"/>
                        <Label text="Phiên đã tham gia"
                               style="-fx-font-size: 10px; -fx-text-fill: #9CA3AF;"/>
                    </VBox>
                    <VBox alignment="CENTER" spacing="4" GridPane.columnIndex="1" GridPane.rowIndex="0"
                          style="-fx-padding: 14 0;
                                 -fx-border-color: #F3F4F6 transparent #F3F4F6 transparent;
                                 -fx-border-width: 1;" prefWidth="240">
                        <Label fx:id="statWin" text="0"
                               style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #22C55E;"/>
                        <Label text="Phiên đã thắng"
                               style="-fx-font-size: 10px; -fx-text-fill: #9CA3AF;"/>
                    </VBox>
                    <!-- Row 2 -->
                    <VBox alignment="CENTER" spacing="4" GridPane.columnIndex="0" GridPane.rowIndex="1"
                          style="-fx-padding: 14 0;
                                 -fx-border-color: transparent #F3F4F6 transparent transparent;
                                 -fx-border-width: 1;" prefWidth="240">
                        <Label fx:id="statWatchlist" text="0"
                               style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #F59E0B;"/>
                        <Label text="Watchlist"
                               style="-fx-font-size: 10px; -fx-text-fill: #9CA3AF;"/>
                    </VBox>
                    <VBox alignment="CENTER" spacing="4" GridPane.columnIndex="1" GridPane.rowIndex="1"
                          style="-fx-padding: 14 0;" prefWidth="240">
                        <Label fx:id="statRate" text="0%"
                               style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #8B5CF6;"/>
                        <Label text="Tỉ lệ thắng"
                               style="-fx-font-size: 10px; -fx-text-fill: #9CA3AF;"/>
                    </VBox>
                </GridPane>
            </VBox>

            <!-- XEM LỊCH SỬ -->
            <Button text="📋 Xem lịch sử đấu giá" onAction="#handleViewHistory"
                    maxWidth="Infinity" prefHeight="44"
                    style="-fx-background-color: white; -fx-text-fill: #1565C0;
                           -fx-font-size: 13px; -fx-font-weight: bold;
                           -fx-background-radius: 12; -fx-cursor: hand;
                           -fx-border-color: #DBEAFE; -fx-border-radius: 12; -fx-border-width: 1.5;"/>

            <Label fx:id="messageLabel" text=""
                   style="-fx-font-size: 12px;" wrapText="true"/>

        </VBox>
    </ScrollPane>
</VBox>