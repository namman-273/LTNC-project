<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.geometry.Insets?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.auction.controller.ui.ProfileController"
      prefWidth="520" prefHeight="680" spacing="0"
      stylesheets="@../style/style.css"
      style="-fx-background-color: #0F172A;">

    <!-- HEADER -->
    <HBox alignment="CENTER_LEFT" spacing="12"
          style="-fx-background-color: #0B1120;
                 -fx-padding: 0 20; -fx-pref-height: 56;
                 -fx-border-color: transparent transparent #1E3A5F transparent;
                 -fx-border-width: 1;">
        <Button text="←" onAction="#handleBack"
                styleClass="btn-ghost"
                style="-fx-font-size: 16px; -fx-padding: 4 12;"/>
        <Label text="🏛 Hồ sơ cá nhân"
               style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #E2E8F0;"/>
    </HBox>

    <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS"
                style="-fx-background-color: transparent; -fx-background: #0F172A;
                       -fx-border-color: transparent;">
        <VBox spacing="10" style="-fx-padding: 14; -fx-background-color: #0F172A;">

            <!-- AVATAR CARD -->
            <HBox spacing="14" alignment="CENTER_LEFT"
                  style="-fx-background-color: #0B1120; -fx-background-radius: 14;
                         -fx-padding: 16 20;
                         -fx-border-color: #1E3A5F; -fx-border-radius: 14; -fx-border-width: 1;">
                <StackPane style="-fx-background-color: #2563EB; -fx-background-radius: 30;
                                  -fx-min-width: 52; -fx-min-height: 52;
                                  -fx-max-width: 52; -fx-max-height: 52;">
                    <Label fx:id="avatarLabel" text="U"
                           style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: white;"/>
                </StackPane>
                <VBox spacing="4">
                    <HBox spacing="8" alignment="CENTER_LEFT">
                        <Label fx:id="usernameLabel" text="username"
                               style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #E2E8F0;"/>
                        <Label fx:id="roleLabel" text="BIDDER"
                               style="-fx-background-color: rgba(59,130,246,0.2); -fx-text-fill: #60A5FA;
                                      -fx-font-size: 10px; -fx-font-weight: bold;
                                      -fx-background-radius: 10; -fx-padding: 2 8;"/>
                    </HBox>
                    <Label fx:id="balanceLabel" text="Số dư: 0 VNĐ"
                           style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #34D399;"/>
                </VBox>
            </HBox>

            <!-- THÔNG TIN CÁ NHÂN -->
            <VBox spacing="0"
                  style="-fx-background-color: #0B1120; -fx-background-radius: 14;
                         -fx-border-color: #1E3A5F; -fx-border-radius: 14; -fx-border-width: 1;">

                <HBox alignment="CENTER_LEFT" style="-fx-padding: 12 16 8 16;">
                    <Label text="Thông tin cá nhân"
                           style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #475569;"/>
                </HBox>

                <!-- Tên đăng nhập -->
                <HBox alignment="CENTER_LEFT" spacing="12"
                      style="-fx-padding: 10 16;
                             -fx-border-color: #1E3A5F transparent transparent transparent;
                             -fx-border-width: 1;">
                    <VBox spacing="2" HBox.hgrow="ALWAYS">
                        <Label text="Tên đăng nhập"
                               style="-fx-font-size: 11px; -fx-text-fill: #475569;"/>
                        <Label fx:id="usernameFieldLabel" text="—"
                               style="-fx-font-size: 13px; -fx-text-fill: #CBD5E1;"/>
                    </VBox>
                    <Label text="Không đổi được"
                           style="-fx-font-size: 11px; -fx-text-fill: #334155;
                                  -fx-background-color: #162236; -fx-background-radius: 6;
                                  -fx-padding: 4 10;"/>
                </HBox>

                <!-- Email -->
                <HBox alignment="CENTER_LEFT" spacing="12"
                      style="-fx-padding: 10 16;
                             -fx-border-color: #1E3A5F transparent transparent transparent;
                             -fx-border-width: 1;">
                    <VBox spacing="4" HBox.hgrow="ALWAYS">
                        <Label text="Email"
                               style="-fx-font-size: 11px; -fx-text-fill: #475569;"/>
                        <TextField fx:id="emailField" promptText="Nhập email..."
                                   prefHeight="34"
                                   style="-fx-font-size: 12px; -fx-background-color: #162236;
                                          -fx-border-color: #1E3A5F; -fx-border-radius: 6;
                                          -fx-background-radius: 6; -fx-padding: 5 10;
                                          -fx-text-fill: #E2E8F0; -fx-prompt-text-fill: #334155;"/>
                    </VBox>
                    <Button text="Sửa" onAction="#handleUpdateEmail"
                            style="-fx-background-color: rgba(59,130,246,0.1); -fx-text-fill: #60A5FA;
                                   -fx-font-size: 11px; -fx-font-weight: bold;
                                   -fx-background-radius: 8; -fx-cursor: hand;
                                   -fx-padding: 6 14; -fx-border-color: #1E3A5F;
                                   -fx-border-radius: 8; -fx-border-width: 1;"/>
                </HBox>

                <!-- Mật khẩu -->
                <VBox style="-fx-border-color: #1E3A5F transparent transparent transparent;
                             -fx-border-width: 1;">
                    <HBox alignment="CENTER_LEFT" spacing="12" style="-fx-padding: 10 16;">
                        <VBox spacing="2" HBox.hgrow="ALWAYS">
                            <Label text="Mật khẩu"
                                   style="-fx-font-size: 11px; -fx-text-fill: #475569;"/>
                            <Label text="••••••••"
                                   style="-fx-font-size: 14px; -fx-text-fill: #CBD5E1;"/>
                        </VBox>
                        <Button text="Đổi" onAction="#handleChangePassword"
                                style="-fx-background-color: rgba(59,130,246,0.1); -fx-text-fill: #60A5FA;
                                       -fx-font-size: 11px; -fx-font-weight: bold;
                                       -fx-background-radius: 8; -fx-cursor: hand;
                                       -fx-padding: 6 14; -fx-border-color: #1E3A5F;
                                       -fx-border-radius: 8; -fx-border-width: 1;"/>
                    </HBox>

                    <!-- Panel đổi mật khẩu -->
                    <VBox fx:id="passwordPanel" spacing="8" visible="false" managed="false"
                          style="-fx-background-color: #162236; -fx-padding: 12 16;
                                 -fx-border-color: #1E3A5F transparent transparent transparent;
                                 -fx-border-width: 1;">
                        <PasswordField fx:id="oldPasswordField" promptText="Mật khẩu hiện tại"
                                       prefHeight="36"
                                       styleClass="text-field-modern"/>
                        <PasswordField fx:id="newPasswordField" promptText="Mật khẩu mới (ít nhất 6 ký tự)"
                                       prefHeight="36"
                                       styleClass="text-field-modern"/>
                        <PasswordField fx:id="confirmPasswordField" promptText="Xác nhận mật khẩu mới"
                                       prefHeight="36"
                                       styleClass="text-field-modern"/>
                        <Button text="Xác nhận đổi mật khẩu" onAction="#handleConfirmChangePassword"
                                maxWidth="Infinity" prefHeight="38"
                                styleClass="btn-primary"/>
                    </VBox>
                </VBox>

                <!-- Vai trò -->
                <HBox alignment="CENTER_LEFT"
                      style="-fx-padding: 10 16;
                             -fx-border-color: #1E3A5F transparent transparent transparent;
                             -fx-border-width: 1;">
                    <VBox spacing="2">
                        <Label text="Vai trò"
                               style="-fx-font-size: 11px; -fx-text-fill: #475569;"/>
                        <Label fx:id="roleDetailLabel" text="—"
                               style="-fx-font-size: 13px; -fx-text-fill: #CBD5E1;"/>
                    </VBox>
                </HBox>

                <!-- Ngày tham gia -->
                <HBox alignment="CENTER_LEFT"
                      style="-fx-padding: 10 16;
                             -fx-border-color: #1E3A5F transparent transparent transparent;
                             -fx-border-width: 1;">
                    <VBox spacing="2">
                        <Label text="Ngày tham gia"
                               style="-fx-font-size: 11px; -fx-text-fill: #475569;"/>
                        <Label fx:id="joinDateLabel" text="—"
                               style="-fx-font-size: 13px; -fx-text-fill: #CBD5E1;"/>
                    </VBox>
                </HBox>
            </VBox>

            <!-- THỐNG KÊ 2x2 -->
            <VBox spacing="0"
                  style="-fx-background-color: #0B1120; -fx-background-radius: 14;
                         -fx-border-color: #1E3A5F; -fx-border-radius: 14; -fx-border-width: 1;">
                <HBox alignment="CENTER_LEFT" style="-fx-padding: 12 16 8 16;">
                    <Label text="Thống kê hoạt động"
                           style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #475569;"/>
                </HBox>
                <GridPane>
                    <VBox alignment="CENTER" spacing="4" GridPane.columnIndex="0" GridPane.rowIndex="0"
                          style="-fx-padding: 14 0;
                                 -fx-border-color: #1E3A5F #1E3A5F #1E3A5F transparent;
                                 -fx-border-width: 1;" prefWidth="240">
                        <Label fx:id="statTotal" text="0"
                               style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #60A5FA;"/>
                        <Label text="Phiên đã tham gia"
                               style="-fx-font-size: 10px; -fx-text-fill: #475569;"/>
                    </VBox>
                    <VBox alignment="CENTER" spacing="4" GridPane.columnIndex="1" GridPane.rowIndex="0"
                          style="-fx-padding: 14 0;
                                 -fx-border-color: #1E3A5F transparent #1E3A5F transparent;
                                 -fx-border-width: 1;" prefWidth="240">
                        <Label fx:id="statWin" text="0"
                               style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #34D399;"/>
                        <Label text="Phiên đã thắng"
                               style="-fx-font-size: 10px; -fx-text-fill: #475569;"/>
                    </VBox>
                    <VBox alignment="CENTER" spacing="4" GridPane.columnIndex="0" GridPane.rowIndex="1"
                          style="-fx-padding: 14 0;
                                 -fx-border-color: transparent #1E3A5F transparent transparent;
                                 -fx-border-width: 1;" prefWidth="240">
                        <Label fx:id="statWatchlist" text="0"
                               style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #FBBF24;"/>
                        <Label text="Đang theo dõi"
                               style="-fx-font-size: 10px; -fx-text-fill: #475569;"/>
                    </VBox>
                    <VBox alignment="CENTER" spacing="4" GridPane.columnIndex="1" GridPane.rowIndex="1"
                          style="-fx-padding: 14 0;" prefWidth="240">
                        <Label fx:id="statRate" text="0%"
                               style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #A78BFA;"/>
                        <Label text="Tỉ lệ thắng"
                               style="-fx-font-size: 10px; -fx-text-fill: #475569;"/>
                    </VBox>
                </GridPane>
            </VBox>

            <!-- XEM LỊCH SỬ -->
            <Button text="📋 Xem lịch sử đấu giá" onAction="#handleViewHistory"
                    maxWidth="Infinity" prefHeight="44"
                    style="-fx-background-color: rgba(59,130,246,0.1); -fx-text-fill: #60A5FA;
                           -fx-font-size: 13px; -fx-font-weight: bold;
                           -fx-background-radius: 12; -fx-cursor: hand;
                           -fx-border-color: #1E3A5F; -fx-border-radius: 12; -fx-border-width: 1;"/>

            <Label fx:id="messageLabel" text=""
                   style="-fx-font-size: 12px;" wrapText="true"/>

        </VBox>
    </ScrollPane>
</VBox>
