<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.geometry.Insets?>

<HBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.auction.controller.ui.WatchlistController"
      prefWidth="900" prefHeight="640" spacing="0"
      stylesheets="@../style/style.css"
      style="-fx-background-color: #F0F4FF;">

    <!-- ═══ SIDEBAR ═══════════════════════════════════════════════════════════ -->
    <VBox prefWidth="220" spacing="0"
          style="-fx-background-color: white;
                 -fx-border-color: transparent #EEEEEE transparent transparent;
                 -fx-border-width: 1;">

        <HBox alignment="CENTER_LEFT" spacing="10"
              style="-fx-padding: 18 16;
                     -fx-border-color: transparent transparent #F0F0F0 transparent;
                     -fx-border-width: 1;">
            <Label text="🏛" style="-fx-font-size: 22px;"/>
            <VBox spacing="0">
                <Label text="1388AUCTION"
                       style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #1565C0;"/>
                <Label text="Hệ thống đấu giá"
                       style="-fx-font-size: 9px; -fx-text-fill: #9CA3AF;"/>
            </VBox>
        </HBox>

        <VBox spacing="2" style="-fx-padding: 10 10;">
            <Button text="🏠  Trang chủ" onAction="#handleBack"
                    prefWidth="200" prefHeight="40"
                    style="-fx-background-color: transparent; -fx-text-fill: #374151;
                           -fx-font-size: 13px; -fx-background-radius: 10; -fx-cursor: hand;
                           -fx-alignment: CENTER_LEFT; -fx-padding: 0 14;"/>
            <Button text="⭐  Watchlist"
                    prefWidth="200" prefHeight="40"
                    style="-fx-background-color: #EEF2FF; -fx-text-fill: #1565C0;
                           -fx-font-size: 13px; -fx-font-weight: bold;
                           -fx-background-radius: 10; -fx-cursor: hand;
                           -fx-alignment: CENTER_LEFT; -fx-padding: 0 14;"/>
        </VBox>
    </VBox>

    <!-- ═══ MAIN CONTENT ══════════════════════════════════════════════════════ -->
    <VBox HBox.hgrow="ALWAYS" spacing="0">

        <!-- HEADER -->
        <HBox alignment="CENTER_LEFT" spacing="12"
              style="-fx-background-color: linear-gradient(to right, #1565C0, #2196F3);
                     -fx-padding: 0 24; -fx-pref-height: 56;">
            <Button text="← Quay lại" onAction="#handleBack"
                    style="-fx-background-color: rgba(255,255,255,0.15);
                           -fx-text-fill: white; -fx-font-size: 12px;
                           -fx-background-radius: 20; -fx-cursor: hand;
                           -fx-border-color: rgba(255,255,255,0.4); -fx-border-radius: 20;
                           -fx-border-width: 1; -fx-padding: 6 14;"/>
            <Label text="⭐ Watchlist của tôi"
                   style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: white;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="🔄 Làm mới" onAction="#handleRefresh"
                    style="-fx-background-color: rgba(255,255,255,0.15);
                           -fx-text-fill: white; -fx-font-size: 12px;
                           -fx-background-radius: 20; -fx-cursor: hand;
                           -fx-border-color: rgba(255,255,255,0.4); -fx-border-radius: 20;
                           -fx-border-width: 1; -fx-padding: 6 14;"/>
        </HBox>

        <!-- STATS BAR -->
        <HBox spacing="12" style="-fx-padding: 14 20; -fx-background-color: white;
                                   -fx-border-color: transparent transparent #EEEEEE transparent;
                                   -fx-border-width: 1;">
            <VBox alignment="CENTER" spacing="2"
                  style="-fx-background-color: #F8F9FF; -fx-background-radius: 10;
                         -fx-padding: 8 20; -fx-border-color: #E0E7FF;
                         -fx-border-radius: 10; -fx-border-width: 1;">
                <Label fx:id="totalCountLabel" text="0"
                       style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #1565C0;"/>
                <Label text="Đang theo dõi"
                       style="-fx-font-size: 11px; -fx-text-fill: #9CA3AF;"/>
            </VBox>
            <VBox alignment="CENTER" spacing="2"
                  style="-fx-background-color: #F0FFF4; -fx-background-radius: 10;
                         -fx-padding: 8 20; -fx-border-color: #BBF7D0;
                         -fx-border-radius: 10; -fx-border-width: 1;">
                <Label fx:id="openCountLabel" text="0"
                       style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #059669;"/>
                <Label text="Đang mở"
                       style="-fx-font-size: 11px; -fx-text-fill: #9CA3AF;"/>
            </VBox>
            <VBox alignment="CENTER" spacing="2"
                  style="-fx-background-color: #F9FAFB; -fx-background-radius: 10;
                         -fx-padding: 8 20; -fx-border-color: #E5E7EB;
                         -fx-border-radius: 10; -fx-border-width: 1;">
                <Label fx:id="finishedCountLabel" text="0"
                       style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #6B7280;"/>
                <Label text="Đã kết thúc"
                       style="-fx-font-size: 11px; -fx-text-fill: #9CA3AF;"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="messageLabel" text=""
                   style="-fx-font-size: 12px; -fx-text-fill: #6B7280;"/>
        </HBox>

        <!-- TABLE (ẩn, giữ để controller hoạt động) -->
        <TableView fx:id="watchlistTable" visible="false" managed="false" prefHeight="0">
            <columns>
                <TableColumn fx:id="idCol"     text="ID"/>
                <TableColumn fx:id="nameCol"   text="Tên"/>
                <TableColumn fx:id="priceCol"  text="Giá"/>
                <TableColumn fx:id="statusCol" text="Trạng thái"/>
            </columns>
        </TableView>

        <!-- CARD LIST -->
        <VBox fx:id="watchlistCards" VBox.vgrow="ALWAYS"
              style="-fx-padding: 14 20;"/>

        <!-- BUTTONS -->
        <HBox spacing="10" alignment="CENTER_RIGHT"
              style="-fx-padding: 12 20; -fx-background-color: white;
                     -fx-border-color: #EEEEEE transparent transparent transparent;
                     -fx-border-width: 1;">
            <Button text="❌ Bỏ theo dõi" onAction="#handleUnwatch"
                    prefHeight="36" prefWidth="140" styleClass="btn-danger"/>
            <Button text="👁 Xem chi tiết" onAction="#handleViewDetail"
                    prefHeight="36" prefWidth="140" styleClass="btn-success"/>
        </HBox>

    </VBox>

</HBox>