<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.geometry.Insets?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.auction.controller.ui.WatchlistController"
      prefWidth="750" prefHeight="560" spacing="15"
      stylesheets="@../style/style.css"
      style="-fx-background-color: #F8F9FA;">
    <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>

    <!-- HEADER -->
    <HBox alignment="CENTER_LEFT" spacing="10"
          style="-fx-background-color: linear-gradient(to right, #1565C0, #2196F3);
                 -fx-background-radius: 10;
                 -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.2), 8, 0, 0, 2);"
          prefHeight="60">
        <padding><Insets top="10" right="20" bottom="10" left="20"/></padding>
        <Button text="← Quay lại" onAction="#handleBack"
                style="-fx-background-color: white; -fx-text-fill: #1565C0;
                       -fx-font-weight: bold; -fx-background-radius: 5;"/>
        <Label text="⭐ WATCHLIST CỦA TÔI"
               style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: white;"/>
        <HBox HBox.hgrow="ALWAYS"/>
        style="-fx-background-color: white; -fx-text-fill: #1565C0;
        -fx-font-weight: bold; -fx-background-radius: 5;"/>
    </HBox>

    <!-- TABLE -->
    <TableView fx:id="watchlistTable" VBox.vgrow="ALWAYS" styleClass="table-view">
        <columns>
            <TableColumn fx:id="idCol" text="ID Phiên" prefWidth="200"/>
            <TableColumn fx:id="nameCol" text="Tên sản phẩm" prefWidth="200"/>
            <TableColumn fx:id="priceCol" text="Giá hiện tại" prefWidth="150"/>
            <TableColumn fx:id="statusCol" text="Trạng thái" prefWidth="120"/>
        </columns>
        <placeholder>
            <Label text="Chưa có phiên nào trong watchlist."
                   style="-fx-text-fill: #AAAAAA; -fx-font-size: 13px;"/>
        </placeholder>
    </TableView>

    <Label fx:id="messageLabel" text=""
           style="-fx-font-size: 12px; -fx-min-height: 18px;"/>

    <!-- BUTTONS -->
    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Button text="❌ Bỏ theo dõi" onAction="#handleUnwatch"
                prefHeight="38" prefWidth="140"
                styleClass="btn-danger"/>
        <Button text="👁 Xem chi tiết" onAction="#handleViewDetail"
                prefHeight="38" prefWidth="140"
                styleClass="btn-success"/>
    </HBox>

</VBox>
