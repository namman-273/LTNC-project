<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.geometry.Insets?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.auction.controllers.BalanceController"
      prefWidth="480" prefHeight="380" spacing="0"
      stylesheets="@style.css"
      style="-fx-background-color: #F8F9FA;">

    <!-- HEADER -->
    <HBox alignment="CENTER_LEFT" spacing="14"
          style="-fx-background-color: linear-gradient(to right, #1565C0, #2196F3);
                 -fx-padding: 0 24; -fx-pref-height: 60;
                 -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.2), 8, 0, 0, 3);">
        <Button text="← Quay lại" onAction="#handleBack"
                style="-fx-background-color: rgba(255,255,255,0.15);
                       -fx-text-fill: white; -fx-font-size: 12px;
                       -fx-background-radius: 8; -fx-cursor: hand;
                       -fx-border-color: rgba(255,255,255,0.4);
                       -fx-border-radius: 8; -fx-border-width: 1;
                       -fx-padding: 6 14;"/>
        <Label text="💰 SỐ DƯ TÀI KHOẢN"
               style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: white;"/>
    </HBox>

    <!-- CONTENT -->
    <VBox spacing="20" VBox.vgrow="ALWAYS">
        <padding><Insets top="30" right="40" bottom="20" left="40"/></padding>

        <!-- Balance Card -->
        <VBox spacing="10" alignment="CENTER"
              style="-fx-background-color: white;
                     -fx-background-radius: 12;
                     -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 8, 0, 0, 2);
                     -fx-padding: 30;">
            <Label fx:id="usernameLabel" text="Tài khoản: ---"
                   style="-fx-font-size: 13px; -fx-text-fill: #888;"/>
            <Label text="Số dư hiện tại"
                   style="-fx-font-size: 13px; -fx-text-fill: #666;"/>
            <Label fx:id="balanceLabel" text="Đang tải..."
                   style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: #1565C0;"/>
            <Button text="🔄 Làm mới" onAction="#handleRefresh"
                    style="-fx-background-color: transparent;
                           -fx-text-fill: #1565C0;
                           -fx-font-size: 12px;
                           -fx-cursor: hand;"/>
        </VBox>

        <!-- Deposit Card -->
        <VBox spacing="12"
              style="-fx-background-color: white;
                     -fx-background-radius: 12;
                     -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 8, 0, 0, 2);
                     -fx-padding: 20;">
            <Label text="💳 Nạp tiền"
                   style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #1565C0;"/>
            <VBox spacing="6">
                <Label text="Số tiền muốn nạp (VNĐ):"
                       style="-fx-font-size: 12px; -fx-text-fill: #666;"/>
                <TextField fx:id="depositAmountField"
                           promptText="Nhập số tiền..."
                           prefHeight="40"
                           styleClass="text-field-modern"/>
            </VBox>
            <Button text="💳 NẠP TIỀN" onAction="#handleDeposit"
                    prefWidth="400" prefHeight="42"
                    styleClass="btn-primary"
                    style="-fx-font-size: 13px; -fx-font-weight: bold;"/>
            <Label fx:id="messageLabel" text=""
                   style="-fx-font-size: 12px;" wrapText="true"/>
        </VBox>
    </VBox>
</VBox>