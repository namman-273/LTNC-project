<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.image.ImageView?>
<?import javafx.geometry.Insets?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.auction.controllers.BidController"
      prefWidth="900" prefHeight="680" spacing="0"
      stylesheets="@style.css"
      style="-fx-background-color: #F0F4FF;">

    <!-- HEADER -->
    <HBox alignment="CENTER_LEFT" spacing="14"
          style="-fx-background-color: linear-gradient(to right, #0D47A1, #2196F3);
                 -fx-padding: 0 24; -fx-pref-height: 60;
                 -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.2), 8, 0, 0, 3);">
        <Button text="← Quay lại danh sách" onAction="#handleBack"
                style="-fx-background-color: rgba(255,255,255,0.15);
                       -fx-text-fill: white; -fx-font-size: 12px;
                       -fx-background-radius: 8; -fx-cursor: hand;
                       -fx-border-color: rgba(255,255,255,0.4);
                       -fx-border-radius: 8; -fx-border-width: 1;
                       -fx-padding: 6 14;"/>
        <Label fx:id="auctionTitleLabel" text="Phiên đấu giá"
               style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: white;"/>
        <Region HBox.hgrow="ALWAYS"/>

    </HBox>

    <!-- BODY -->
    <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS"
                style="-fx-background-color: transparent; -fx-border-color: transparent;">
        <VBox spacing="0">

            <HBox spacing="20">
                <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>

                <!-- CỘT TRÁI — ảnh + mô tả + lịch sử -->
                <VBox spacing="14" prefWidth="440" HBox.hgrow="ALWAYS">

                    <!-- Ảnh sản phẩm -->
                    <VBox styleClass="card" spacing="10">
                        <ImageView fx:id="productImage"
                                   fitWidth="400" fitHeight="220"
                                   preserveRatio="true"
                                   visible="false" managed="false"
                                   style="-fx-background-radius: 10;"/>

                        <!-- Placeholder khi không có ảnh -->
                        <VBox fx:id="imagePlaceholder" prefHeight="160" alignment="CENTER"
                              style="-fx-background-color: #EEF2FF;
                                     -fx-background-radius: 10;">
                            <Label text="🖼️"
                                   style="-fx-font-size: 48px;"/>
                            <Label text="Không có ảnh sản phẩm"
                                   style="-fx-font-size: 11px; -fx-text-fill: #AAAAAA;"/>
                        </VBox>

                        <!-- Tên + Trạng thái -->
                        <HBox spacing="10" alignment="CENTER_LEFT">
                            <Label fx:id="itemNameLabel" text="---"
                                   style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #1A1A2E;"
                                   wrapText="true" HBox.hgrow="ALWAYS"/>
                            <Label fx:id="statusLabel" text="OPEN"
                                   style="-fx-font-size: 11px; -fx-font-weight: bold;
                                          -fx-text-fill: white; -fx-background-color: #2E7D32;
                                          -fx-background-radius: 12; -fx-padding: 3 10;"/>
                        </HBox>

                        <!-- ID phiên -->
                        <Label fx:id="auctionIdLabel" text="---"
                               style="-fx-font-size: 11px; -fx-text-fill: #2196F3;"/>
                    </VBox>

                    <!-- Mô tả sản phẩm -->
                    <VBox fx:id="descriptionBox" styleClass="card" spacing="8"
                          visible="false" managed="false">
                        <Label text="📝 Mô tả sản phẩm"
                               style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #1565C0;"/>
                        <Label fx:id="descriptionLabel" text=""
                               style="-fx-font-size: 12px; -fx-text-fill: #555;"
                               wrapText="true"/>
                    </VBox>

                    <!-- Lịch sử đặt giá -->
                    <VBox spacing="8" VBox.vgrow="ALWAYS" styleClass="card">
                        <Label text="📋 Lịch sử đặt giá"
                               style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #1565C0;"/>
                        <ListView fx:id="bidHistoryList" prefHeight="200"
                                  styleClass="list-view"/>
                    </VBox>
                </VBox>

                <!-- CỘT PHẢI — đặt giá + countdown + tính năng -->
                <VBox spacing="14" prefWidth="380">

                    <!-- Giá + Countdown lớn -->
                    <VBox spacing="10"
                          style="-fx-background-color: white;
                                 -fx-background-radius: 14;
                                 -fx-effect: dropshadow(gaussian, rgba(21,101,192,0.1), 12, 0, 0, 3);
                                 -fx-padding: 20;">

                        <Label text="Giá hiện tại"
                               style="-fx-font-size: 12px; -fx-text-fill: #888;"/>
                        <Label fx:id="currentPriceLabel" text="---"
                               style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #1565C0;"/>

                        <!-- Countdown -->
                        <HBox spacing="6" alignment="CENTER_LEFT"
                              style="-fx-background-color: #EEF5FF; -fx-background-radius: 8; -fx-padding: 8 12;">
                            <Label text="⏰ Thời gian còn lại:"
                                   style="-fx-font-size: 12px; -fx-text-fill: #666;"/>
                            <Label fx:id="countdownLabel" text="--:--:--"
                                   style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #1565C0;"/>
                        </HBox>

                        <Label fx:id="messageLabel" text=""
                               style="-fx-font-size: 12px;" wrapText="true"/>
                    </VBox>

                    <!-- Đặt giá -->
                    <VBox spacing="12" styleClass="card">
                        <Label text="🔨 Đặt giá đầu"
                               style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #1565C0;"/>

                        <VBox spacing="5">
                            <Label text="Nhập giá của bạn (VND):"
                                   style="-fx-font-size: 12px; -fx-text-fill: #666;"/>
                            <TextField fx:id="bidAmountField" promptText="Nhập số tiền..."
                                       prefHeight="44" styleClass="text-field-modern"/>
                            <Label text="Giá đặt phải cao hơn giá hiện tại"
                                   style="-fx-font-size: 11px; -fx-text-fill: #AAAAAA;"/>
                        </VBox>

                        <!-- Quick buttons -->
                        <HBox spacing="8">
                            <Button text="+1M" prefWidth="115" prefHeight="34"
                                    styleClass="btn-outline"
                                    onAction="#handleQuickBid1M"/>
                            <Button text="+5M" prefWidth="115" prefHeight="34"
                                    styleClass="btn-outline"
                                    onAction="#handleQuickBid5M"/>
                            <Button text="+10M" prefWidth="115" prefHeight="34"
                                    styleClass="btn-outline"
                                    onAction="#handleQuickBid10M"/>
                        </HBox>

                        <Button text="🔨 ĐẶT GIÁ NGAY" onAction="#handleBid"
                                prefWidth="350" prefHeight="46"
                                styleClass="btn-danger"
                                style="-fx-font-size: 14px; -fx-font-weight: bold;"/>
                    </VBox>

                    <!-- Tính năng nâng cao -->
                    <VBox spacing="10" styleClass="card">
                        <Label text="⚡ Tính năng nâng cao"
                               style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #1565C0;"/>
                        <Button text="📊 Xem biểu đồ giá" onAction="#handleViewChart"
                                prefWidth="350" prefHeight="38"
                                styleClass="btn-outline"/>
                        <Button text="🤖 Quản lý Auto-Bid" onAction="#handleAutoBid"
                                prefWidth="350" prefHeight="38"
                                style="-fx-background-color: #1565C0;
                                       -fx-text-fill: white; -fx-font-size: 12px;
                                       -fx-font-weight: bold; -fx-background-radius: 8;
                                       -fx-cursor: hand;"/>
                    </VBox>

                    <!-- SNIPING -->
                    <VBox fx:id="snipingBox" spacing="6" styleClass="card"
                          style="-fx-background-color: #FFF3E0;
                                 -fx-border-color: #FFB74D;
                                 -fx-border-radius: 12; -fx-border-width: 1;
                                 -fx-padding: 12;"
                          visible="false" managed="false">
                        <Label text="⏱ Phiên vừa được gia hạn!"
                               style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #E65100;"/>
                        <Label fx:id="snipingCountdownLabel" text="Còn: 02:00"
                               style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #BF360C;"/>
                        <Label fx:id="snipingCountLabel" text=""
                               style="-fx-font-size: 11px; -fx-text-fill: #E65100;"/>
                    </VBox>

                    <!-- Hướng dẫn -->
                    <VBox spacing="8" styleClass="card"
                          style="-fx-background-color: #E8F5E9;
                                 -fx-border-color: #A5D6A7;
                                 -fx-border-radius: 12; -fx-border-width: 1;">
                        <Label text="💡 Hướng dẫn"
                               style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #2E7D32;"/>
                        <Label text="• Nhập giá cao hơn giá hiện tại"
                               style="-fx-font-size: 12px; -fx-text-fill: #388E3C;" wrapText="true"/>
                        <Label text="• Giá cập nhật tự động realtime"
                               style="-fx-font-size: 12px; -fx-text-fill: #388E3C;" wrapText="true"/>
                        <Label text="• Người đặt cao nhất khi hết thời gian thắng"
                               style="-fx-font-size: 12px; -fx-text-fill: #388E3C;" wrapText="true"/>
                    </VBox>

                </VBox>
            </HBox>
        </VBox>
    </ScrollPane>
</VBox>